    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Visit_SaveFourDiagnosis">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-VISIT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">就诊记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.FourDiagnosis&quot;, &quot;setValue&quot;: &quot;新增或更新本次就诊唯一一份四诊信息&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.FourDiagnosis.pulseCode&quot;, &quot;setValue&quot;: &quot;按录入值保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">visit.visitStatus == &apos;接诊中&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">脉象为必填项</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-04；录入或修改本次就诊的望闻问切结构化记录（聚合内子实体，同事务）</rdfs:comment>
        <rdfs:label xml:lang="zh">录入四诊信息</rdfs:label>
        <skos:notation>Visit_SaveFourDiagnosis</skos:notation>
    </owl:NamedIndividual>
    


