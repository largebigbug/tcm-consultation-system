        <tcm-ontology:dictionaryId>DICT-SYNDROME</tcm-ontology:dictionaryId>
        <rdfs:comment xml:lang="zh"></rdfs:comment>
        <rdfs:label xml:lang="zh">结论状态</rdfs:label>
        <skos:notation>CONCLUSION_STATUS</skos:notation>
    </owl:Class>
    


