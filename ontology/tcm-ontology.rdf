        <tcm-ontology:parameter>{&quot;name&quot;: &quot;prescriptionType&quot;, &quot;label&quot;: &quot;处方类型&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;prescription.prescriptionType&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;statsDimension&quot;, &quot;label&quot;: &quot;统计维度&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;HERB&quot;, &quot;enumValues&quot;: [&quot;HERB&quot;, &quot;FORMULA_TEMPLATE&quot;], &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;itemAgg.herbId&quot;}</tcm-ontology:parameter>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;avgSingleDose&quot;, &quot;label&quot;: &quot;单剂平均用量（g）&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;SUM(itemAgg.doseSum * prescription.doses) / NULLIF(SUM(prescription.doses), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0.00&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;doseCount&quot;, &quot;label&quot;: &quot;使用剂数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;prescription.doses&quot;, &quot;aggregateFunction&quot;: &quot;SUM&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
