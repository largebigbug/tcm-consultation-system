    <!-- http://hermes.local/tcm-ontology#Behavior_Visit_Receive -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Visit_Receive">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-VISIT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">就诊记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.doctorId&quot;, &quot;setValue&quot;: &quot;当前登录用户&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.receiveTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.visitStatus&quot;, &quot;setValue&quot;: &quot;接诊中&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">visit.visitStatus == &apos;已挂号&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">主诉已填写，长度不超过 200 字（该环节负责录入主诉）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-03；医师开始接诊，记录接诊时间与接诊医师</rdfs:comment>
        <rdfs:label xml:lang="zh">接诊开单</rdfs:label>
        <skos:notation>Visit_Receive</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Visit_Register -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Visit_Register">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-VISIT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">就诊记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.registerTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.visitStatus&quot;, &quot;setValue&quot;: &quot;已挂号&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">patient.patientStatus == &apos;在用&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">就诊类型为复诊时必须选定上次就诊记录</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-02；为患者在门诊挂号并建立就诊记录</rdfs:comment>
        <rdfs:label xml:lang="zh">门诊挂号</rdfs:label>
        <skos:notation>Visit_Register</skos:notation>
    </owl:NamedIndividual>
    


