    </owl:Class>
    


    <!-- http://hermes.local/tcm-ontology#SyndromeDiagnosis -->

    <owl:Class rdf:about="http://hermes.local/tcm-ontology#SyndromeDiagnosis">
        <rdfs:subClassOf rdf:resource="http://hermes.local/tcm-ontology#Aggregate"/>
        <tcm-ontology:lifecycle xml:lang="zh">草稿 → 已确认</tcm-ontology:lifecycle>
        <rdfs:comment xml:lang="zh">医师基于四诊得出的证型判定与治法，可含主证与兼证</rdfs:comment>
        <rdfs:label xml:lang="en">SyndromeDiagnosis</rdfs:label>
        <rdfs:label xml:lang="zh">辨证结论</rdfs:label>
        <skos:notation>AGG-DIAGNOSIS-001</skos:notation>
    </owl:Class>
    


    <!-- http://hermes.local/tcm-ontology#SyndromeType -->

