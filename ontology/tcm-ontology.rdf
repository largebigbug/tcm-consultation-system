        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;formulaName&quot;, &quot;label&quot;: &quot;方剂名称&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;formula.formulaName&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;formulaRefCount&quot;, &quot;label&quot;: &quot;引用张数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;prescription.prescriptionNo&quot;, &quot;aggregateFunction&quot;: &quot;COUNT_DISTINCT&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;formulaRefRatio&quot;, &quot;label&quot;: &quot;引用占比&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;COUNT(DISTINCT prescription.prescriptionNo) / NULLIF(SUBTOTAL(COUNT(DISTINCT prescription.prescriptionNo)), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;formulaType&quot;, &quot;label&quot;: &quot;方剂类型&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;sourceExpression&quot;: &quot;formula.formulaType&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;herbCategory&quot;, &quot;label&quot;: &quot;药材类别&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;sourceExpression&quot;: &quot;herb.herbCategory&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;herbCode&quot;, &quot;label&quot;: &quot;饮片编码&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;herb.herbCode&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;herbName&quot;, &quot;label&quot;: &quot;饮片名称&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;herb.herbName&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
