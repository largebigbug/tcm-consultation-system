        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;alertGap&quot;, &quot;label&quot;: &quot;预警差额（g）&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;herb.lowStockThreshold - herb.stockQuantity&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0.00&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
