        <tcm-ontology:grantsPermission rdf:resource="http://hermes.local/tcm-ontology#Permission_PERM_AUTO_STOCK_DEDUCT"/>
        <tcm-ontology:grantsPermission rdf:resource="http://hermes.local/tcm-ontology#Permission_PERM_AUTO_STOCK_RETURN"/>
        <tcm-ontology:grantsPermission rdf:resource="http://hermes.local/tcm-ontology#Permission_PERM_AUTO_VISIT_COMPLETE"/>
        <rdfs:comment xml:lang="zh">由 syncTriggers 同步调用执行的系统行为主体，无人工登录账号</rdfs:comment>
        <rdfs:label xml:lang="zh">系统自动执行主体</rdfs:label>
        <skos:notation>ROLE-07</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_FOLLOWUP_DATE_ORDER -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_FOLLOWUP_DATE_ORDER">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;actualFollowUpDate &gt;= DATE(sourceVisitRegisterTime)&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;actualFollowUpDate&quot;, &quot;type&quot;: &quot;Date&quot;, &quot;sourceField&quot;: &quot;FollowUp.actualFollowUpDate&quot;, &quot;required&quot;: true}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;sourceVisitRegisterTime&quot;, &quot;type&quot;: &quot;DateTime&quot;, &quot;sourceField&quot;: &quot;Visit.registerTime&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;上次就诊（随访来源）的挂号时间&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>Boolean</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>FollowUp_Complete</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">实际随访日期不得早于随访来源就诊的挂号时间；违反时提示并要求修正（D-17）。</rdfs:comment>
        <rdfs:label xml:lang="zh">复诊日期顺序校验</rdfs:label>
        <skos:notation>RULE-FOLLOWUP-DATE-ORDER</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_RECONCILE -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_RECONCILE">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;stockQuantity - flowNetQuantity&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;flowNetQuantity&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;SUM(HerbStockFlow.quantity)&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;该饮片全部出入库流水数量净和（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;stockQuantity&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;Herb.stockQuantity&quot;, &quot;required&quot;: true}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>Decimal</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>Herb_Stocktake</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">盘点时以饮片库存数量与全部出入库流水数量净和比对，输出对账结论与差异值（不阻断业务，供盘点人员据以发起盘点调整）。
与 M1 聚合不变量 INV-03 同源：INV-03 为写入时强制的聚合不变量，本规则为盘点行为的对账判定与差异呈现。依据 INV-03。</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片库存对账校验</rdfs:label>
        <skos:notation>RULE-HERB-STOCK-RECONCILE</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_SUFFICIENT -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_SUFFICIENT">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;FOR EACH item IN prescriptionItems:\n  IF item.singleDose * prescription.doses &gt; herb(item.herbId).stockQuantity THEN RETURN false\nRETURN true&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;requiredQuantity&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;PrescriptionItem.singleDose * Prescription.doses&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;该味饮片需求总量 = 单剂剂量 × 剂数（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;stockQuantity&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;Herb.stockQuantity&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;饮片当前库存数量（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>Boolean</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>Dispense_Confirm</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">按处方剂数计算各味饮片需求总量，逐味比对饮片当前库存数量，任一味不足则阻断调剂（D-14）。</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片库存充足校验</rdfs:label>
        <skos:notation>RULE-HERB-STOCK-SUFFICIENT</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;IF toxicityLevel == &apos;NONE&apos; THEN RETURN true\nIF toxicDoseLimit IS NULL THEN RETURN true\nRETURN totalDoseInPrescription &lt;= toxicDoseLimit&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;herbId&quot;, &quot;type&quot;: &quot;String&quot;, &quot;sourceField&quot;: &quot;PrescriptionItem.herbId&quot;, &quot;required&quot;: true}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;totalDoseInPrescription&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;SUM(PrescriptionItem.singleDose)&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;同一处方内该味饮片的单剂总量（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;toxicDoseLimit&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;Herb.toxicDoseLimit&quot;, &quot;required&quot;: false, &quot;description&quot;: &quot;毒性单张处方总量上限（g），为空表示不单独设限&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;toxicityLevel&quot;, &quot;type&quot;: &quot;String&quot;, &quot;sourceField&quot;: &quot;Herb.toxicityLevel&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;毒性分级字典值，NONE 表示无毒&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>Boolean</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>Prescription_Submit</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">对处方内毒性分级非「无毒」的饮片，按单剂剂量汇总同味饮片总量，与饮片维护的「毒性单张处方总量上限」比对，
超上限即阻断提交；未维护上限的毒性饮片只做强制审核提示。依据 D-11。</rdfs:comment>
        <rdfs:label xml:lang="zh">毒性饮片处方总量上限校验</rdfs:label>
        <skos:notation>RULE-HERB-TOXIC-TOTAL-LIMIT-CHECK</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;IF singleDose &lt;= maxCommonDose THEN &apos;PASS&apos;\nELSE IF singleDose &gt; maxCommonDose * 2 THEN &apos;BLOCK&apos;\nELSE IF overDoseReason IS NULL OR LENGTH(overDoseReason) == 0 THEN &apos;NEED_REASON&apos;\nELSE &apos;NEED_REASON&apos;&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;maxCommonDose&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;Herb.maxCommonDose&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;饮片常用最大量（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;minCommonDose&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;Herb.minCommonDose&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;饮片常用最小量（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;overDoseReason&quot;, &quot;type&quot;: &quot;String&quot;, &quot;sourceField&quot;: &quot;PrescriptionItem.overDoseReason&quot;, &quot;required&quot;: false, &quot;description&quot;: &quot;超量理由，超常用上限时必填&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;singleDose&quot;, &quot;type&quot;: &quot;Decimal&quot;, &quot;sourceField&quot;: &quot;PrescriptionItem.singleDose&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;处方明细单剂剂量（g）&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>String</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>Prescription_Save</tcm-ontology:reusedByBehavior>
        <tcm-ontology:reusedByBehavior>Prescription_Submit</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">读取处方明细的单剂剂量与所引饮片的常用量区间，判定三种处理结论：
PASS（未超常用上限，正常放行）/ NEED_REASON（超常用上限但在 2 倍以内，必须填写超量理由并强制药师审核）/
BLOCK（超过常用上限 2 倍，直接阻断提交）。依据 D-11、D-16。</rdfs:comment>
        <rdfs:label xml:lang="zh">剂量超常用量上限处理判定</rdfs:label>
        <skos:notation>RULE-PRESCRIPTION-DOSE-LIMIT-CHECK</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_VOID_DISPATCH -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_VOID_DISPATCH">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Rule"/>
        <tcm-ontology:expression>&quot;IF recordStatus IS NULL THEN RETURN &apos;VOID_ONLY&apos;\nIF recordStatus == &apos;PENDING&apos; THEN RETURN &apos;VOID_ONLY&apos;\nIF recordStatus == &apos;DISPENSED&apos; THEN RETURN &apos;VOID_WITH_ROLLBACK&apos;\nIF recordStatus == &apos;ISSUED&apos; THEN RETURN &apos;BLOCK&apos;\nRETURN &apos;VOID_ONLY&apos;&quot;</tcm-ontology:expression>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;prescriptionStatus&quot;, &quot;type&quot;: &quot;String&quot;, &quot;sourceField&quot;: &quot;Prescription.prescriptionStatus&quot;, &quot;required&quot;: true, &quot;description&quot;: &quot;当前处方状态&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:inputParam>{&quot;name&quot;: &quot;recordStatus&quot;, &quot;type&quot;: &quot;String&quot;, &quot;sourceField&quot;: &quot;DispenseRecord.recordStatus&quot;, &quot;required&quot;: false, &quot;description&quot;: &quot;调剂发药记录状态；无记录时为空&quot;}</tcm-ontology:inputParam>
        <tcm-ontology:outputType>String</tcm-ontology:outputType>
        <tcm-ontology:reusedByBehavior>Prescription_Cancel</tcm-ontology:reusedByBehavior>
        <tcm-ontology:ruleType>VALIDATION</tcm-ontology:ruleType>
        <rdfs:comment xml:lang="zh">按调剂发药记录状态三分派：无记录或「待调剂」→ VOID_ONLY（允许作废，无库存动作，同步取消待调剂记录）；
「已调剂」→ VOID_WITH_ROLLBACK（允许作废并按 B-02 回冲库存）；「已发药」→ BLOCK（阻断作废，
退药走线下处理）。规则只判断与分派，状态变化由行为完成。依据 D-08、D-19。</rdfs:comment>
        <rdfs:label xml:lang="zh">处方作废处理判定与阻断</rdfs:label>
        <skos:notation>RULE-PRESCRIPTION-VOID-DISPATCH</skos:notation>
    </owl:NamedIndividual>
    


