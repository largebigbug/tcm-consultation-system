        <tcm-ontology:parameter>{&quot;name&quot;: &quot;visitDateTo&quot;, &quot;label&quot;: &quot;就诊日期止&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;MONTH_END&quot;, &quot;allowedOperators&quot;: [&quot;LE&quot;], &quot;sourceField&quot;: &quot;visit.registerTime&quot;}</tcm-ontology:parameter>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;caseCount&quot;, &quot;label&quot;: &quot;辨证例数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;diagnosis.diagnosisNo&quot;, &quot;aggregateFunction&quot;: &quot;COUNT&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;caseRatio&quot;, &quot;label&quot;: &quot;占比&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;COUNT(diagnosis.diagnosisNo) / NULLIF(SUBTOTAL(COUNT(diagnosis.diagnosisNo)), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;diagnosisMethod&quot;, &quot;label&quot;: &quot;所属辨证体系&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;sourceExpression&quot;: &quot;syndrome.diagnosisMethod&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;syndromeCode&quot;, &quot;label&quot;: &quot;证型编码&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;syndrome.syndromeCode&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;syndromeName&quot;, &quot;label&quot;: &quot;证型名称&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;syndrome.syndromeName&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;syndromeNature&quot;, &quot;label&quot;: &quot;证型性质&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;sourceExpression&quot;: &quot;diagnosis.syndromeNature&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:sourceObject>AGG-DIAGNOSIS-001 (主表)</tcm-ontology:sourceObject>
