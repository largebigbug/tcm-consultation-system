    <owl:Ontology rdf:about="http://hermes.local/tcm-ontology#ontology">
        <terms:source>中医问诊系统-需求规格说明书-V9</terms:source>
        <rdfs:comment xml:lang="zh">由 7 个本体模型（M1/M2/M3/M5/M6/M7/MU）机械生成；领域：中医问诊</rdfs:comment>
        <rdfs:label xml:lang="zh">中医问诊系统本体</rdfs:label>
        <owl:versionInfo>2.1</owl:versionInfo>
    </owl:Ontology>
    


