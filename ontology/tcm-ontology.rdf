    <!-- http://hermes.local/tcm-ontology#DispenseRecord_prescriptionId -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_prescriptionId">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Prescription"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">一张处方对应一条调剂发药记录（一对一）</rdfs:comment>
        <rdfs:label xml:lang="zh">处方</rdfs:label>
        <skos:notation>prescriptionId</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#DispenseRecord_recordStatus -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_recordStatus">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Enum_DISPENSE_STATUS"/>
        <tcm-ontology:defaultValue>PENDING</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">记录状态</rdfs:label>
        <skos:notation>recordStatus</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_actualVisitId -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_actualVisitId">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Visit"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">患者实际复诊时回填</rdfs:comment>
        <rdfs:label xml:lang="zh">本次就诊</rdfs:label>
        <skos:notation>actualVisitId</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_efficacyLevel -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_efficacyLevel">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Enum_EFFICACY_LEVEL"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">疗效评价</rdfs:label>
        <skos:notation>efficacyLevel</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_patientId -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_patientId">
