        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;herbCode&quot;, &quot;label&quot;: &quot;饮片编码&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;herb.herbCode&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
