        <tcm-ontology:lifecycle xml:lang="zh">草稿 → 待审核 → 审核通过 → 已驳回 → 已调剂 → 已发药 → 已作废</tcm-ontology:lifecycle>
        <rdfs:comment xml:lang="zh">医师为某次就诊开具的中药处方，含剂数、用法与审核状态</rdfs:comment>
        <rdfs:label xml:lang="en">Prescription</rdfs:label>
        <rdfs:label xml:lang="zh">处方</rdfs:label>
        <skos:notation>AGG-PRESCRIPTION-001</skos:notation>
    </owl:Class>
    


