    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_herbStatus -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#Herb_herbStatus">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Enum_USE_STATUS"/>
        <tcm-ontology:defaultValue>ENABLED</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">状态</rdfs:label>
        <skos:notation>herbStatus</skos:notation>
