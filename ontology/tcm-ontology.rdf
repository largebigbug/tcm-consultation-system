    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_aliasName">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">便于检索</rdfs:comment>
        <rdfs:label xml:lang="zh">别名</rdfs:label>
        <skos:notation>aliasName</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_efficacy -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_efficacy">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">功效</rdfs:label>
        <skos:notation>efficacy</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_herbCode -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_herbCode">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">规则：Y + 四位流水号</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片编码</rdfs:label>
        <skos:notation>herbCode</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_herbName -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_herbName">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">如「当归」</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片名称</rdfs:label>
        <skos:notation>herbName</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_lowStockThreshold -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_lowStockThreshold">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位 g</rdfs:comment>
        <rdfs:label xml:lang="zh">低库存预警值</rdfs:label>
        <skos:notation>lowStockThreshold</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_maxCommonDose -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_maxCommonDose">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位 g；供 M3 规则 R-01 判定超量使用</rdfs:comment>
        <rdfs:label xml:lang="zh">常用最大量</rdfs:label>
        <skos:notation>maxCommonDose</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_minCommonDose -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_minCommonDose">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位 g</rdfs:comment>
        <rdfs:label xml:lang="zh">常用最小量</rdfs:label>
        <skos:notation>minCommonDose</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_natureMeridian -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_natureMeridian">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">展示与参考用</rdfs:comment>
        <rdfs:label xml:lang="zh">性味归经</rdfs:label>
        <skos:notation>natureMeridian</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_origin -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_origin">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">产地</rdfs:label>
        <skos:notation>origin</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_spec -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_spec">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">如「统货 / 选货」</rdfs:comment>
        <rdfs:label xml:lang="zh">规格</rdfs:label>
        <skos:notation>spec</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_specialManaged -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_specialManaged">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <tcm-ontology:defaultValue>False</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">是否特殊管理</rdfs:label>
        <skos:notation>specialManaged</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_stockQuantity -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_stockQuantity">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <tcm-ontology:defaultValue>0</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位 g；由出入库流水（B-01 扣减 / B-02 回冲）驱动</rdfs:comment>
        <rdfs:label xml:lang="zh">库存数量</rdfs:label>
        <skos:notation>stockQuantity</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Herb_toxicDoseLimit -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Herb_toxicDoseLimit">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位 g；毒性分级非「无毒」时由库房管理员维护，供 M3 规则 R-03 判定；为空表示不单独设限（需求文档 OBJ-07 v1.1 已定义，M1 于 2026-09-30 批次 2 实施时补全）</rdfs:comment>
        <rdfs:label xml:lang="zh">毒性单张处方总量上限</rdfs:label>
        <skos:notation>toxicDoseLimit</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_address -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_address">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">联系地址</rdfs:label>
        <skos:notation>address</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_age -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_age">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">单位「岁」；有出生日期时自动计算，否则人工填写</rdfs:comment>
        <rdfs:label xml:lang="zh">年龄</rdfs:label>
        <skos:notation>age</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_allergyHistory -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_allergyHistory">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">药物/食物过敏记录；跨就诊长期有效，置于患者主数据（D-09）</rdfs:comment>
        <rdfs:label xml:lang="zh">过敏史</rdfs:label>
        <skos:notation>allergyHistory</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_birthDate -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_birthDate">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">出生日期</rdfs:label>
        <skos:notation>birthDate</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_idNo -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_idNo">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">与证件类型联合唯一（INV-01）；类型为居民身份证时须 18 位且校验位正确（REF-03）</rdfs:comment>
        <rdfs:label xml:lang="zh">证件号码</rdfs:label>
        <skos:notation>idNo</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_occupation -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_occupation">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">自由文本，中医问诊常需参考职业与劳损因素</rdfs:comment>
        <rdfs:label xml:lang="zh">职业</rdfs:label>
        <skos:notation>occupation</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_patientName -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_patientName">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">患者姓名</rdfs:label>
        <skos:notation>patientName</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_patientNo -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_patientNo">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">系统生成，两位前缀 + 六位流水号；只读</rdfs:comment>
        <rdfs:label xml:lang="zh">患者编号</rdfs:label>
        <skos:notation>patientNo</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_phone -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_phone">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">联系电话</rdfs:label>
        <skos:notation>phone</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Patient_remark -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Patient_remark">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">备注</rdfs:label>
        <skos:notation>remark</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#Prescription_cancelReason -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#Prescription_cancelReason">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Prescription"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">处方状态为「已作废」时必填；FUNC-09 作废时填写，处方不物理删除</rdfs:comment>
        <rdfs:label xml:lang="zh">作废原因</rdfs:label>
        <skos:notation>cancelReason</skos:notation>
    </owl:DatatypeProperty>
    


