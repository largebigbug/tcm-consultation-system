    <!-- http://hermes.local/tcm-ontology#DispenseRecord_checkerId -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_checkerId">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">选填，不强制（单节点审核，D-24）；引用平台用户 ID</rdfs:comment>
        <rdfs:label xml:lang="zh">复核人</rdfs:label>
        <skos:notation>checkerId</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#DispenseRecord_dispenseNo -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_dispenseNo">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">系统生成</rdfs:comment>
        <rdfs:label xml:lang="zh">发药单号</rdfs:label>
        <skos:notation>dispenseNo</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#DispenseRecord_dispenseTime -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_dispenseTime">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">调剂时间</rdfs:label>
        <skos:notation>dispenseTime</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#DispenseRecord_dispenserId -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_dispenserId">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">中药师；引用平台用户 ID</rdfs:comment>
        <rdfs:label xml:lang="zh">调剂人</rdfs:label>
        <skos:notation>dispenserId</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#DispenseRecord_issueTime -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#DispenseRecord_issueTime">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#DispenseRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">REF-14：不得早于调剂时间</rdfs:comment>
        <rdfs:label xml:lang="zh">发药时间</rdfs:label>
        <skos:notation>issueTime</skos:notation>
    </owl:DatatypeProperty>
    


