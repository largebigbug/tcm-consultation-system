    <!-- http://hermes.local/tcm-ontology#Enum_EFFICACY_LEVEL -->

    <owl:Class rdf:about="http://hermes.local/tcm-ontology#Enum_EFFICACY_LEVEL">
        <rdfs:subClassOf rdf:resource="http://hermes.local/tcm-ontology#Enumeration"/>
