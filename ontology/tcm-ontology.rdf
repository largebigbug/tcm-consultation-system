        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">系统生成</rdfs:comment>
        <rdfs:label xml:lang="zh">随访号</rdfs:label>
        <skos:notation>followUpNo</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_plannedFollowUpDate -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_plannedFollowUpDate">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">默认取上次就诊日期 + 处方剂数对应天数（D-17）</rdfs:comment>
        <rdfs:label xml:lang="zh">计划随访日期</rdfs:label>
        <skos:notation>plannedFollowUpDate</skos:notation>
    </owl:DatatypeProperty>
    


