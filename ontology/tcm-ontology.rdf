        <rdfs:label xml:lang="zh">聚合根</rdfs:label>
    </owl:Class>
    


    <!-- http://hermes.local/tcm-ontology#Behavior -->

    <owl:Class rdf:about="http://hermes.local/tcm-ontology#Behavior">
