    <!-- http://hermes.local/tcm-ontology#Report_RPT_VISIT_STATS_001 -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Report_RPT_VISIT_STATS_001">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Report"/>
        <tcm-ontology:behaviorRef>Visit_QueryStats</tcm-ontology:behaviorRef>
        <tcm-ontology:groupBy>DATE_TRUNC(visit.registerTime, granularity)</tcm-ontology:groupBy>
        <tcm-ontology:groupBy>visit.deptCode</tcm-ontology:groupBy>
        <tcm-ontology:groupBy>visit.doctorId</tcm-ontology:groupBy>
        <tcm-ontology:groupBy>visit.visitType</tcm-ontology:groupBy>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;deptCode&quot;, &quot;label&quot;: &quot;科室&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.deptCode&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;doctorId&quot;, &quot;label&quot;: &quot;接诊医师&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.doctorId&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;granularity&quot;, &quot;label&quot;: &quot;日期粒度&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;DAY&quot;, &quot;enumValues&quot;: [&quot;DAY&quot;, &quot;MONTH&quot;], &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.registerTime&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;registerDateFrom&quot;, &quot;label&quot;: &quot;挂号日期起&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;MONTH_START&quot;, &quot;allowedOperators&quot;: [&quot;GE&quot;], &quot;sourceField&quot;: &quot;visit.registerTime&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;registerDateTo&quot;, &quot;label&quot;: &quot;挂号日期止&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;MONTH_END&quot;, &quot;allowedOperators&quot;: [&quot;LE&quot;], &quot;sourceField&quot;: &quot;visit.registerTime&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;visitStatus&quot;, &quot;label&quot;: &quot;就诊状态&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.visitStatus&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;visitType&quot;, &quot;label&quot;: &quot;就诊类型&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.visitType&quot;}</tcm-ontology:parameter>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;cancelledCount&quot;, &quot;label&quot;: &quot;已取消人次&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN visit.visitStatus = &apos;CANCELLED&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;completedCount&quot;, &quot;label&quot;: &quot;已完成人次&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN visit.visitStatus = &apos;COMPLETED&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;deptCode&quot;, &quot;label&quot;: &quot;科室&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;sourceExpression&quot;: &quot;visit.deptCode&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;doctorId&quot;, &quot;label&quot;: &quot;接诊医师&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;visit.doctorId&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;firstVisitCount&quot;, &quot;label&quot;: &quot;初诊人次&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN visit.visitType = &apos;FIRST&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;followUpRatio&quot;, &quot;label&quot;: &quot;复诊占比&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN visit.visitType = &apos;FOLLOW_UP&apos; THEN 1 ELSE 0 END) / NULLIF(COUNT(visit.visitNo), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;followUpVisitCount&quot;, &quot;label&quot;: &quot;复诊人次&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN visit.visitType = &apos;FOLLOW_UP&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;patientCount&quot;, &quot;label&quot;: &quot;就诊人数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;visit.patientId&quot;, &quot;aggregateFunction&quot;: &quot;COUNT_DISTINCT&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;statDate&quot;, &quot;label&quot;: &quot;统计日期&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;sourceExpression&quot;: &quot;DATE_TRUNC(visit.registerTime, granularity)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;yyyy-MM-dd&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;visitCount&quot;, &quot;label&quot;: &quot;就诊人次&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;visit.visitNo&quot;, &quot;aggregateFunction&quot;: &quot;COUNT&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;visitType&quot;, &quot;label&quot;: &quot;就诊类型&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;sourceExpression&quot;: &quot;visit.visitType&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:sourceObject>AGG-PATIENT-001</tcm-ontology:sourceObject>
        <tcm-ontology:sourceObject>AGG-VISIT-001 (主表)</tcm-ontology:sourceObject>
        <rdfs:comment xml:lang="zh">按期间、科室、接诊医师与就诊类型统计门诊接诊量，掌握门诊负荷与初诊/复诊结构；表格底部给出合计行</rdfs:comment>
        <rdfs:label xml:lang="en">visitStats</rdfs:label>
        <rdfs:label xml:lang="zh">门诊量统计</rdfs:label>
        <skos:notation>RPT-VISIT-STATS-001</skos:notation>
    </owl:NamedIndividual>
    


