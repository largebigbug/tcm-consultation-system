        <skos:notation>remark</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_actualFollowUpDate -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_actualFollowUpDate">
