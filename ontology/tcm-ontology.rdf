    <!-- http://hermes.local/tcm-ontology#Herb_toxicityLevel -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#Herb_toxicityLevel">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#Herb"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Enum_TOXICITY_LEVEL"/>
        <tcm-ontology:defaultValue>NONE</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">供 M3 规则 R-03 判定毒性上限</rdfs:comment>
        <rdfs:label xml:lang="zh">毒性分级</rdfs:label>
        <skos:notation>toxicityLevel</skos:notation>
    </owl:ObjectProperty>
    


