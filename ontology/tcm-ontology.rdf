        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">是否继续用药</rdfs:label>
        <skos:notation>continueMedication</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_followUpNo -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_followUpNo">
