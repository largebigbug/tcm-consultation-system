        <tcm-ontology:lifecycle xml:lang="zh">启用 → 停用</tcm-ontology:lifecycle>
        <rdfs:comment xml:lang="zh">证型的标准化定义，供辨证结论引用</rdfs:comment>
        <rdfs:label xml:lang="en">SyndromeType</rdfs:label>
        <rdfs:label xml:lang="zh">证型字典</rdfs:label>
        <skos:notation>AGG-SYNDROME-001</skos:notation>
