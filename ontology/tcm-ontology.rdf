        <rdfs:comment xml:lang="zh">患者一次到院就诊的业务主记录，承载主诉、现病史与就诊状态；一次就诊一份四诊信息</rdfs:comment>
        <rdfs:label xml:lang="en">Visit</rdfs:label>
        <rdfs:label xml:lang="zh">就诊记录</rdfs:label>
        <skos:notation>AGG-VISIT-001</skos:notation>
    </owl:Class>
    


