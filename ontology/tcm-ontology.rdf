    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Diagnosis_Confirm">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DIAGNOSIS-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">辨证结论</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;syndromeDiagnosis.conclusionStatus&quot;, &quot;setValue&quot;: &quot;已确认&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">主证性质结论在同一就诊下唯一（INV-02）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">所属就诊未完成（visit.visitStatus == &apos;接诊中&apos;）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">治法已填写</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-05；结论定稿，之后可据此开方</rdfs:comment>
        <rdfs:label xml:lang="zh">确认辨证结论</rdfs:label>
        <skos:notation>Diagnosis_Confirm</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Diagnosis_QuerySyndromeDistribution -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Diagnosis_QuerySyndromeDistribution">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>QUERY</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DIAGNOSIS-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">辨证结论</tcm-ontology:ownerEntityName>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 Q-02</rdfs:comment>
        <rdfs:label xml:lang="zh">查询证型分布统计</rdfs:label>
        <skos:notation>Diagnosis_QuerySyndromeDistribution</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Diagnosis_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Diagnosis_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DIAGNOSIS-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">辨证结论</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;syndromeDiagnosis.conclusionStatus&quot;, &quot;setValue&quot;: &quot;草稿&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">所属就诊存在四诊信息</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">证型、辨证方法、证型性质已选择</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">辨证依据不少于 10 字</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-05；保存辨证结论草稿，可反复修改</rdfs:comment>
        <rdfs:label xml:lang="zh">保存辨证结论草稿</rdfs:label>
        <skos:notation>Diagnosis_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Dispense_CancelPending -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Dispense_CancelPending">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliedRule>RULE-PRESCRIPTION-VOID-DISPATCH</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DISPENSE-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">调剂发药记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.recordStatus&quot;, &quot;setValue&quot;: &quot;已取消&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">R-04 判定结果为 VOID_ONLY</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">dispenseRecord.recordStatus == &apos;待调剂&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">处方状态已为「已作废」</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-06（建模补全）；处方作废经 R-04 判定为「无记录/待调剂」分支时同步执行，
取消该处方的待调剂记录（已发药记录不可取消）</rdfs:comment>
        <rdfs:label xml:lang="zh">取消待调剂记录</rdfs:label>
        <skos:notation>Dispense_CancelPending</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Dispense_Confirm -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Dispense_Confirm">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_SUFFICIENT"/>
        <tcm-ontology:appliedRule>RULE-HERB-STOCK-SUFFICIENT</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DISPENSE-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">调剂发药记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.dispenseTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.dispenserId&quot;, &quot;setValue&quot;: &quot;当前登录用户&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.recordStatus&quot;, &quot;setValue&quot;: &quot;已调剂&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;已调剂&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">R-02 判定全部饮片库存充足</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">dispenseRecord.recordStatus == &apos;待调剂&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">对应处方状态为「审核通过」</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-10；确认调剂并同步扣减饮片库存（D-14）。库存不足由 R-02 阻断，
不允许先调剂后补库</rdfs:comment>
        <rdfs:label xml:lang="zh">确认调剂</rdfs:label>
        <skos:notation>Dispense_Confirm</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Dispense_CreatePending -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Dispense_CreatePending">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DISPENSE-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">调剂发药记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.dispenseNo&quot;, &quot;setValue&quot;: &quot;系统生成&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.recordStatus&quot;, &quot;setValue&quot;: &quot;待调剂&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">prescription.prescriptionStatus == &apos;审核通过&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">该处方不存在调剂发药记录（一对一约束）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-05（建模补全）；处方审核通过后由审批流「通过」分支调用，
生成该处方的调剂发药记录（状态「待调剂」），成为药剂师调剂入口</rdfs:comment>
        <rdfs:label xml:lang="zh">创建待调剂记录</rdfs:label>
        <skos:notation>Dispense_CreatePending</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Dispense_Issue -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Dispense_Issue">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-DISPENSE-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">调剂发药记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.issueTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;dispenseRecord.recordStatus&quot;, &quot;setValue&quot;: &quot;已发药&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;已发药&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">dispenseRecord.recordStatus == &apos;已调剂&apos;</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-10；确认发药，处方业务闭环（库存已在确认调剂时扣减）</rdfs:comment>
        <rdfs:label xml:lang="zh">发药确认</rdfs:label>
        <skos:notation>Dispense_Issue</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_FollowUp_Complete -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_FollowUp_Complete">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_FOLLOWUP_DATE_ORDER"/>
        <tcm-ontology:appliedRule>RULE-FOLLOWUP-DATE-ORDER</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FOLLOWUP-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">复诊随访记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.actualFollowUpDate&quot;, &quot;setValue&quot;: &quot;按填入值保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.actualVisitId&quot;, &quot;setValue&quot;: &quot;本次就诊记录&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.efficacyLevel&quot;, &quot;setValue&quot;: &quot;按评价结果保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.recordStatus&quot;, &quot;setValue&quot;: &quot;已完成&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">followUp.recordStatus == &apos;待随访&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">实际随访日期不早于上次就诊挂号时间（R-05）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">本次就诊记录已选定</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-13；患者实际复诊时回填本次就诊并记录疗效评价</rdfs:comment>
        <rdfs:label xml:lang="zh">复诊登记与疗效评价</rdfs:label>
        <skos:notation>FollowUp_Complete</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_FollowUp_CreatePlan -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_FollowUp_CreatePlan">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FOLLOWUP-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">复诊随访记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.followUpNo&quot;, &quot;setValue&quot;: &quot;系统生成&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.plannedFollowUpDate&quot;, &quot;setValue&quot;: &quot;就诊日期 + 剂数 × 1 天（按用法折算）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.recordStatus&quot;, &quot;setValue&quot;: &quot;待随访&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">就诊状态为「已完成」</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">该次就诊存在提交成功的处方</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-03；就诊完成后生成待随访记录，计划随访日期 = 就诊日 + 剂数 × 1 天（D-17）</rdfs:comment>
        <rdfs:label xml:lang="zh">复诊提醒生成</rdfs:label>
        <skos:notation>FollowUp_CreatePlan</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_FollowUp_MarkLost -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_FollowUp_MarkLost">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FOLLOWUP-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">复诊随访记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.recordStatus&quot;, &quot;setValue&quot;: &quot;已失访&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;followUp.remark&quot;, &quot;setValue&quot;: &quot;追加失访原因&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">followUp.recordStatus == &apos;待随访&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">失访原因已填写</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">计划随访日期已超期</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-13；计划随访日期超期且患者未复诊时标记失访，不物理删除</rdfs:comment>
        <rdfs:label xml:lang="zh">标记失访</rdfs:label>
        <skos:notation>FollowUp_MarkLost</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_FollowUp_QueryCompletion -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_FollowUp_QueryCompletion">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>QUERY</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FOLLOWUP-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">复诊随访记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 Q-07</rdfs:comment>
        <rdfs:label xml:lang="zh">查询随访完成与失访分析</rdfs:label>
        <skos:notation>FollowUp_QueryCompletion</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Formula_ChangeStatus -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Formula_ChangeStatus">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FORMULA-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">方剂模板</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;formulaTemplate.formulaStatus&quot;, &quot;setValue&quot;: &quot;停用 或 启用&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">formulaTemplate.formulaStatus == &apos;启用&apos;（停用）或 &apos;停用&apos;（启用）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-14；被处方引用后不可删除，只能停用</rdfs:comment>
        <rdfs:label xml:lang="zh">方剂模板停用与启用</rdfs:label>
        <skos:notation>Formula_ChangeStatus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Formula_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Formula_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-FORMULA-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">方剂模板</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;formulaTemplate.FormulaItem&quot;, &quot;setValue&quot;: &quot;全量覆盖保存组成明细&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;formulaTemplate.formulaCode&quot;, &quot;setValue&quot;: &quot;按规则生成或保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">方剂名称唯一</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">方剂编码符合 F + 三位流水号规则</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">组成明细至少一味药味，且药味不重复</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-14；维护方剂模板及其组成明细（聚合内子实体，同事务）</rdfs:comment>
        <rdfs:label xml:lang="zh">方剂模板新增与修改</rdfs:label>
        <skos:notation>Formula_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_ChangeStatus -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_ChangeStatus">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.herbStatus&quot;, &quot;setValue&quot;: &quot;停用 或 启用&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">herb.herbStatus == &apos;启用&apos;（停用）或 &apos;停用&apos;（启用）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-11（停用并入建档入库功能，D-31）；产生过流水或被处方引用后不可删除</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片停用与启用</rdfs:label>
        <skos:notation>Herb_ChangeStatus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_DeductStock -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_DeductStock">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliedRule>RULE-HERB-STOCK-SUFFICIENT</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.HerbStockFlow&quot;, &quot;setValue&quot;: &quot;逐味追加业务类型为「调剂出库」的流水（数量为负）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.stockQuantity&quot;, &quot;setValue&quot;: &quot;stockQuantity - 单剂剂量 × 剂数&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">R-02 判定库存充足</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">扣减后库存不为负（REF-08）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-01；确认调剂时经 R-02 校验通过后同步执行，
按单剂剂量 × 剂数扣减各味饮片库存并追加调剂出库流水（同一聚合、同一事务）</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片库存扣减</rdfs:label>
        <skos:notation>Herb_DeductStock</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_Inbound -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_Inbound">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.HerbStockFlow&quot;, &quot;setValue&quot;: &quot;追加一条业务类型为「入库」的流水（数量为正）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.stockQuantity&quot;, &quot;setValue&quot;: &quot;stockQuantity + 入库数量&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">herb.herbStatus == &apos;启用&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">入伙数量大于 0</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">入库单号已填写</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-11；登记合格入库数量与入库单号（饮片验收留线下，D-27），
同时追加「入库」流水并增加库存，二者属同一聚合、同一事务</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片入库登记</rdfs:label>
        <skos:notation>Herb_Inbound</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_QueryStockAndAlert -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_QueryStockAndAlert">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>QUERY</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 Q-05</rdfs:comment>
        <rdfs:label xml:lang="zh">查询饮片库存与预警</rdfs:label>
        <skos:notation>Herb_QueryStockAndAlert</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_ReturnStock -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_ReturnStock">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliedRule>RULE-PRESCRIPTION-VOID-DISPATCH</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.HerbStockFlow&quot;, &quot;setValue&quot;: &quot;逐味追加业务类型为「作废回冲」的流水（数量为正）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.stockQuantity&quot;, &quot;setValue&quot;: &quot;stockQuantity + 原出库数量&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">R-04 判定结果为 VOID_WITH_ROLLBACK</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">对应调剂出库流水存在</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-02；处方作废经 R-04 判定为「已调剂」分支时同步执行，
按原出库量回冲库存并追加作废回冲流水</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片库存回冲</rdfs:label>
        <skos:notation>Herb_ReturnStock</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.herbCode&quot;, &quot;setValue&quot;: &quot;按规则生成或保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.stockQuantity&quot;, &quot;setValue&quot;: &quot;新增时为 0，不由本行为直接修改&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">常用最小量 &gt; 0 且常用最大量 ≥ 常用最小量</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">毒性分级已选择</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">饮片名称唯一</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">饮片编码符合 Y + 四位流水号规则</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-11；建立或修改饮片品目基础信息（常用量区间、毒性分级、预警值等）</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片建档与修改</rdfs:label>
        <skos:notation>Herb_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Herb_Stocktake -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Herb_Stocktake">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_HERB_STOCK_RECONCILE"/>
        <tcm-ontology:appliedRule>RULE-HERB-STOCK-RECONCILE</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-HERB-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">中药饮片</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.HerbStockFlow&quot;, &quot;setValue&quot;: &quot;追加一条业务类型为「盘点调整」或「报损」的流水&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;herb.stockQuantity&quot;, &quot;setValue&quot;: &quot;stockQuantity + 调整数量&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">盘点调整原因或报损原因已填写</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">调整后库存数量不得为负（REF-08）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">调整数量不得为 0（REF-13）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-12；按实盘结果登记盘点调整或报损（追加流水并修正库存），
盘点前调用 R-06 输出账实差异供人工确认；低库存预警只做查询呈现，不推送（D-22）</rdfs:comment>
        <rdfs:label xml:lang="zh">饮片库存盘点调整</rdfs:label>
        <skos:notation>Herb_Stocktake</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Patient_ChangeStatus -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Patient_ChangeStatus">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PATIENT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">患者</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;patient.patientStatus&quot;, &quot;setValue&quot;: &quot;停用 或 在用&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">patient.patientStatus == &apos;在用&apos;（停用）或 &apos;停用&apos;（启用）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">停用时该患者不存在「已挂号」或「接诊中」的就诊记录</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-01（停用并入建档功能，D-23）；不物理删除患者档案</rdfs:comment>
        <rdfs:label xml:lang="zh">患者停用与启用</rdfs:label>
        <skos:notation>Patient_ChangeStatus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Patient_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Patient_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PATIENT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">患者</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;patient.age&quot;, &quot;setValue&quot;: &quot;有出生日期时按出生日期自动计算&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;patient.patientStatus&quot;, &quot;setValue&quot;: &quot;在用（新增时按默认值写入）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">出生日期与年龄至少填写一项</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">同一「证件类型 + 证件号码」不存在重复建档（INV-01）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">患者姓名为必填且长度 2～20 字</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-01；新增患者档案或修改既有档案基本信息</rdfs:comment>
        <rdfs:label xml:lang="zh">患者建档与修改</rdfs:label>
        <skos:notation>Patient_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_Cancel -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_Cancel">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_VOID_DISPATCH"/>
        <tcm-ontology:appliedRule>RULE-PRESCRIPTION-VOID-DISPATCH</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.cancelReason&quot;, &quot;setValue&quot;: &quot;写入作废原因&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;已作废&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">R-04 判定结果不为 BLOCK（已发药/已作废不可作废）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">prescription.prescriptionStatus IN [&apos;草稿&apos;, &apos;待审核&apos;, &apos;审核通过&apos;, &apos;已调剂&apos;]</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">作废原因已填写</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-09；作废按 R-04 三分派执行——无调剂记录或「待调剂」记录时仅作废并取消待调剂记录；
「已调剂」时作废并回冲库存；「已发药」时阻断作废（退药走线下）。不物理删除处方</rdfs:comment>
        <rdfs:label xml:lang="zh">处方退回与作废</rdfs:label>
        <skos:notation>Prescription_Cancel</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_QueryHerbUsage -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_QueryHerbUsage">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>QUERY</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 Q-03</rdfs:comment>
        <rdfs:label xml:lang="zh">查询方剂与饮片使用统计</rdfs:label>
        <skos:notation>Prescription_QueryHerbUsage</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_QueryOverdoseReview -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_QueryOverdoseReview">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>QUERY</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 Q-06</rdfs:comment>
        <rdfs:label xml:lang="zh">查询超量毒性处方审核台账</rdfs:label>
        <skos:notation>Prescription_QueryOverdoseReview</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_Review -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_Review">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;审核通过 或 已驳回&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.reviewTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.reviewerId&quot;, &quot;setValue&quot;: &quot;当前登录用户&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">prescription.prescriptionStatus == &apos;待审核&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">当前用户具备中药师角色（ROLE-03）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">驳回时驳回原因已填写</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应审批行为 B-APP-01；中药师单节点审核（D-24：不做会签与条件加签，复核人选填）。
审核通过置「审核通过」并进入调剂；驳回须填驳回原因并置「已驳回」，医师修改后可重新提交</rdfs:comment>
        <rdfs:label xml:lang="zh">处方审核</rdfs:label>
        <skos:notation>Prescription_Review</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK"/>
        <tcm-ontology:appliedRule>RULE-PRESCRIPTION-DOSE-LIMIT-CHECK</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.PrescriptionItem&quot;, &quot;setValue&quot;: &quot;全量覆盖保存处方明细（含超量理由）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescribeTime&quot;, &quot;setValue&quot;: &quot;NOW()（首次保存时）&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;草稿&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">visit.visitStatus == &apos;接诊中&apos;；或处方状态为「已驳回」时允许修改后重新提交（M6 Q04 驳回重提闭环，此时就诊已随提交收尾为「已完成」）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">剂数在 1 到 30 之间（REF-10）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">同一处方内饮片不重复，单剂剂量大于 0（REF-12）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">所属就诊存在「已确认」的辨证结论</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-06；开具或修改处方主表与明细（聚合内同事务）。
超量处理结论由 R-01 判定：NEED_REASON 时超量理由必填，BLOCK 时不允许保存</rdfs:comment>
        <rdfs:label xml:lang="zh">开具处方与保存草稿</rdfs:label>
        <skos:notation>Prescription_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Prescription_Submit -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Prescription_Submit">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK"/>
        <tcm-ontology:appliesRule rdf:resource="http://hermes.local/tcm-ontology#Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK"/>
        <tcm-ontology:appliedRule>RULE-HERB-TOXIC-TOTAL-LIMIT-CHECK</tcm-ontology:appliedRule>
        <tcm-ontology:appliedRule>RULE-PRESCRIPTION-DOSE-LIMIT-CHECK</tcm-ontology:appliedRule>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-PRESCRIPTION-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">处方</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.prescriptionStatus&quot;, &quot;setValue&quot;: &quot;待审核&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;prescription.submitTime&quot;, &quot;setValue&quot;: &quot;NOW()&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">prescription.prescriptionStatus IN [&apos;草稿&apos;, &apos;已驳回&apos;]</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">处方明细至少一味饮片（INV-04）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">超量药味已填写超量理由</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-07；处方明细非空（INV-04）后提交进入药师审核队列，
并同步触发就诊状态收尾（B-04）。超常用量上限 2 倍或超毒性上限由规则阻断</rdfs:comment>
        <rdfs:label xml:lang="zh">提交处方送审</rdfs:label>
        <skos:notation>Prescription_Submit</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Syndrome_ChangeStatus -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Syndrome_ChangeStatus">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-SYNDROME-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">证型字典</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;syndromeType.syndromeStatus&quot;, &quot;setValue&quot;: &quot;停用 或 启用&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">syndromeType.syndromeStatus == &apos;启用&apos;（停用）或 &apos;停用&apos;（启用）</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-15；被引用后不可删除，只能停用</rdfs:comment>
        <rdfs:label xml:lang="zh">证型字典停用与启用</rdfs:label>
        <skos:notation>Syndrome_ChangeStatus</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Syndrome_Save -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Syndrome_Save">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-SYNDROME-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">证型字典</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;syndromeType.syndromeCode&quot;, &quot;setValue&quot;: &quot;按规则生成或保存&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">所属辨证体系已选择</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">证型名称唯一</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">证型编码符合 Z + 三位流水号规则</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-15；维护证型标准化定义</rdfs:comment>
        <rdfs:label xml:lang="zh">证型字典新增与修改</rdfs:label>
        <skos:notation>Syndrome_Save</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Visit_Cancel -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Visit_Cancel">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-VISIT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">就诊记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.remark&quot;, &quot;setValue&quot;: &quot;追加撤销原因&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.visitStatus&quot;, &quot;setValue&quot;: &quot;已取消&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">visit.visitStatus IN [&apos;已挂号&apos;, &apos;接诊中&apos;]</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">撤销原因已填写（记入备注）</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">该就诊下不存在任何处方</tcm-ontology:precondition>
        <tcm-ontology:triggerType>USER_ACTION</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 FUNC-16；患者未就诊或误挂号时撤销就诊，不物理删除</rdfs:comment>
        <rdfs:label xml:lang="zh">撤销就诊</rdfs:label>
        <skos:notation>Visit_Cancel</skos:notation>
    </owl:NamedIndividual>
    


    <!-- http://hermes.local/tcm-ontology#Behavior_Visit_Complete -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Behavior_Visit_Complete">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Behavior"/>
        <tcm-ontology:behaviorType>COMMAND</tcm-ontology:behaviorType>
        <tcm-ontology:ownerEntity>AGG-VISIT-001</tcm-ontology:ownerEntity>
        <tcm-ontology:ownerEntityName xml:lang="zh">就诊记录</tcm-ontology:ownerEntityName>
        <tcm-ontology:postcondition>{&quot;field&quot;: &quot;visit.visitStatus&quot;, &quot;setValue&quot;: &quot;已完成&quot;}</tcm-ontology:postcondition>
        <tcm-ontology:precondition xml:lang="zh">visit.visitStatus == &apos;接诊中&apos;</tcm-ontology:precondition>
        <tcm-ontology:precondition xml:lang="zh">存在已提交成功的处方</tcm-ontology:precondition>
        <tcm-ontology:triggerType>SYSTEM</tcm-ontology:triggerType>
        <rdfs:comment xml:lang="zh">对应 B-04；处方提交送审成功后由 Prescription_Submit 同步触发，就诊置「已完成」</rdfs:comment>
        <rdfs:label xml:lang="zh">就诊状态收尾</rdfs:label>
        <skos:notation>Visit_Complete</skos:notation>
    </owl:NamedIndividual>
    


