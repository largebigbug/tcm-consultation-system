        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Patient"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">患者</rdfs:label>
        <skos:notation>patientId</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_recordStatus -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_recordStatus">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Enum_FOLLOWUP_STATUS"/>
        <tcm-ontology:defaultValue>PENDING</tcm-ontology:defaultValue>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:label xml:lang="zh">记录状态</rdfs:label>
        <skos:notation>recordStatus</skos:notation>
    </owl:ObjectProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_sourceVisitId -->

    <owl:ObjectProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_sourceVisitId">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://hermes.local/tcm-ontology#Visit"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">随访来源就诊</rdfs:comment>
        <rdfs:label xml:lang="zh">上次就诊</rdfs:label>
        <skos:notation>sourceVisitId</skos:notation>
    </owl:ObjectProperty>
    


