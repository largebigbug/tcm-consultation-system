    <!-- http://hermes.local/tcm-ontology#Report_RPT_FOLLOWUP_COMPLETION_001 -->

    <owl:NamedIndividual rdf:about="http://hermes.local/tcm-ontology#Report_RPT_FOLLOWUP_COMPLETION_001">
        <rdf:type rdf:resource="http://hermes.local/tcm-ontology#Report"/>
        <tcm-ontology:behaviorRef>FollowUp_QueryCompletion</tcm-ontology:behaviorRef>
        <tcm-ontology:groupBy>DATE_TRUNC(followUp.plannedFollowUpDate, MONTH)</tcm-ontology:groupBy>
        <tcm-ontology:groupBy>visit.deptCode</tcm-ontology:groupBy>
        <tcm-ontology:groupBy>visit.doctorId</tcm-ontology:groupBy>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;deptCode&quot;, &quot;label&quot;: &quot;科室&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.deptCode&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;doctorId&quot;, &quot;label&quot;: &quot;接诊医师&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;], &quot;sourceField&quot;: &quot;visit.doctorId&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;efficacyLevel&quot;, &quot;label&quot;: &quot;疗效评价&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;, &quot;IN&quot;], &quot;sourceField&quot;: &quot;followUp.efficacyLevel&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;plannedDateFrom&quot;, &quot;label&quot;: &quot;计划随访日期起&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;MONTH_START&quot;, &quot;allowedOperators&quot;: [&quot;GE&quot;], &quot;sourceField&quot;: &quot;followUp.plannedFollowUpDate&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;plannedDateTo&quot;, &quot;label&quot;: &quot;计划随访日期止&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;required&quot;: false, &quot;defaultValue&quot;: &quot;MONTH_END&quot;, &quot;allowedOperators&quot;: [&quot;LE&quot;], &quot;sourceField&quot;: &quot;followUp.plannedFollowUpDate&quot;}</tcm-ontology:parameter>
        <tcm-ontology:parameter>{&quot;name&quot;: &quot;recordStatus&quot;, &quot;label&quot;: &quot;随访状态&quot;, &quot;dataType&quot;: &quot;Enum&quot;, &quot;required&quot;: false, &quot;allowedOperators&quot;: [&quot;EQ&quot;, &quot;IN&quot;], &quot;sourceField&quot;: &quot;followUp.recordStatus&quot;}</tcm-ontology:parameter>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;aggravatedCount&quot;, &quot;label&quot;: &quot;加重数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel = &apos;AGGRAVATED&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;completedCount&quot;, &quot;label&quot;: &quot;已完成数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.recordStatus = &apos;COMPLETED&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;completionRatio&quot;, &quot;label&quot;: &quot;完成率&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.recordStatus = &apos;COMPLETED&apos; THEN 1 ELSE 0 END) / NULLIF(COUNT(followUp.followUpNo), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;curedCount&quot;, &quot;label&quot;: &quot;痊愈数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel = &apos;CURED&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;deptCode&quot;, &quot;label&quot;: &quot;科室&quot;, &quot;dataType&quot;: &quot;DictionaryRef&quot;, &quot;sourceExpression&quot;: &quot;visit.deptCode&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;doctorId&quot;, &quot;label&quot;: &quot;接诊医师&quot;, &quot;dataType&quot;: &quot;String&quot;, &quot;sourceExpression&quot;: &quot;visit.doctorId&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: null, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;effectiveCount&quot;, &quot;label&quot;: &quot;有效数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel = &apos;EFFECTIVE&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;effectiveRatio&quot;, &quot;label&quot;: &quot;有效率&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel IN (&apos;CURED&apos;, &apos;MARKED_EFFECT&apos;, &apos;EFFECTIVE&apos;) THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN followUp.recordStatus = &apos;COMPLETED&apos; THEN 1 ELSE 0 END), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;ineffectiveCount&quot;, &quot;label&quot;: &quot;无效数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel = &apos;INEFFECTIVE&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;lostCount&quot;, &quot;label&quot;: &quot;已失访数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.recordStatus = &apos;LOST&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;lostRatio&quot;, &quot;label&quot;: &quot;失访率&quot;, &quot;dataType&quot;: &quot;Decimal&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.recordStatus = &apos;LOST&apos; THEN 1 ELSE 0 END) / NULLIF(COUNT(followUp.followUpNo), 0)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;0.00%&quot;, &quot;nullable&quot;: true, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;markedEffectCount&quot;, &quot;label&quot;: &quot;显效数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;SUM(CASE WHEN followUp.efficacyLevel = &apos;MARKED_EFFECT&apos; THEN 1 ELSE 0 END)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: false}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;plannedCount&quot;, &quot;label&quot;: &quot;计划随访数&quot;, &quot;dataType&quot;: &quot;Integer&quot;, &quot;sourceExpression&quot;: &quot;followUp.followUpNo&quot;, &quot;aggregateFunction&quot;: &quot;COUNT&quot;, &quot;format&quot;: &quot;#,##0&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:resultColumn>{&quot;name&quot;: &quot;statPeriod&quot;, &quot;label&quot;: &quot;统计期间&quot;, &quot;dataType&quot;: &quot;Date&quot;, &quot;sourceExpression&quot;: &quot;DATE_TRUNC(followUp.plannedFollowUpDate, MONTH)&quot;, &quot;aggregateFunction&quot;: &quot;NONE&quot;, &quot;format&quot;: &quot;yyyy-MM&quot;, &quot;nullable&quot;: false, &quot;visible&quot;: true, &quot;sortable&quot;: true}</tcm-ontology:resultColumn>
        <tcm-ontology:sourceObject>AGG-FOLLOWUP-001 (主表)</tcm-ontology:sourceObject>
        <tcm-ontology:sourceObject>AGG-PATIENT-001</tcm-ontology:sourceObject>
        <tcm-ontology:sourceObject>AGG-VISIT-001</tcm-ontology:sourceObject>
        <rdfs:comment xml:lang="zh">统计复诊随访的完成率、失访率与疗效分布，评估治疗依从性与疗效；底部合计</rdfs:comment>
        <rdfs:label xml:lang="en">followUpCompletion</rdfs:label>
        <rdfs:label xml:lang="zh">随访完成与失访分析</rdfs:label>
        <skos:notation>RPT-FOLLOWUP-COMPLETION-001</skos:notation>
    </owl:NamedIndividual>
    


