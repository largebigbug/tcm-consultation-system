    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_remark">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">失访原因等</rdfs:comment>
        <rdfs:label xml:lang="zh">备注</rdfs:label>
        <skos:notation>remark</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FollowUp_symptomChange -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FollowUp_symptomChange">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FollowUp"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:label xml:lang="zh">症状变化</rdfs:label>
        <skos:notation>symptomChange</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_defaultDoses -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_defaultDoses">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">开方时默认带入处方剂数</rdfs:comment>
        <rdfs:label xml:lang="zh">常用剂数</rdfs:label>
        <skos:notation>defaultDoses</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_formulaCode -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_formulaCode">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">规则：F + 三位流水号</rdfs:comment>
        <rdfs:label xml:lang="zh">方剂编码</rdfs:label>
        <skos:notation>formulaCode</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_formulaName -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_formulaName">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>true</tcm-ontology:required>
        <tcm-ontology:unique>true</tcm-ontology:unique>
        <rdfs:comment xml:lang="zh">如「逍遥散」</rdfs:comment>
        <rdfs:label xml:lang="zh">方剂名称</rdfs:label>
        <skos:notation>formulaName</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_function -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_function">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">如「疏肝解郁、健脾养血」</rdfs:comment>
        <rdfs:label xml:lang="zh">功用</rdfs:label>
        <skos:notation>function</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_indication -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_indication">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">适用证型与症状</rdfs:comment>
        <rdfs:label xml:lang="zh">主治</rdfs:label>
        <skos:notation>indication</skos:notation>
    </owl:DatatypeProperty>
    


    <!-- http://hermes.local/tcm-ontology#FormulaTemplate_source -->

    <owl:DatatypeProperty rdf:about="http://hermes.local/tcm-ontology#FormulaTemplate_source">
        <rdfs:domain rdf:resource="http://hermes.local/tcm-ontology#FormulaTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">典籍或经验来源</rdfs:comment>
        <rdfs:label xml:lang="zh">出处</rdfs:label>
        <skos:notation>source</skos:notation>
    </owl:DatatypeProperty>
    


