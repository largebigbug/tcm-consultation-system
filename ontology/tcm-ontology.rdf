        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <tcm-ontology:required>false</tcm-ontology:required>
        <rdfs:comment xml:lang="zh">不得早于上次就诊时间，由 M3 规则 R-05 校验</rdfs:comment>
        <rdfs:label xml:lang="zh">实际随访日期</rdfs:label>
        <skos:notation>actualFollowUpDate</skos:notation>
    </owl:DatatypeProperty>
    


