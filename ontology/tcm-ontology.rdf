    <!-- http://hermes.local/tcm-ontology#DispenseRecord -->

    <owl:Class rdf:about="http://hermes.local/tcm-ontology#DispenseRecord">
        <rdfs:subClassOf rdf:resource="http://hermes.local/tcm-ontology#Aggregate"/>
        <tcm-ontology:lifecycle xml:lang="zh">待调剂 → 已调剂 → 已发药 → 已取消</tcm-ontology:lifecycle>
        <rdfs:comment xml:lang="zh">中药师针对一张处方的调剂与发药执行记录，一张处方对应一条记录</rdfs:comment>
        <rdfs:label xml:lang="en">DispenseRecord</rdfs:label>
        <rdfs:label xml:lang="zh">调剂发药记录</rdfs:label>
        <skos:notation>AGG-DISPENSE-001</skos:notation>
    </owl:Class>
    


