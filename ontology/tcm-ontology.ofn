# Individual: tcm:Report_RPT_FOLLOWUP_COMPLETION_001 (随访完成与失访分析)

AnnotationAssertion(tcm:behaviorRef tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "FollowUp_QueryCompletion")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "DATE_TRUNC(followUp.plannedFollowUpDate, MONTH)")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "visit.deptCode")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "visit.doctorId")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.deptCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"doctorId\", \"label\": \"接诊医师\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.doctorId\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"efficacyLevel\", \"label\": \"疗效评价\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\", \"IN\"], \"sourceField\": \"followUp.efficacyLevel\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"plannedDateFrom\", \"label\": \"计划随访日期起\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_START\", \"allowedOperators\": [\"GE\"], \"sourceField\": \"followUp.plannedFollowUpDate\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"plannedDateTo\", \"label\": \"计划随访日期止\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_END\", \"allowedOperators\": [\"LE\"], \"sourceField\": \"followUp.plannedFollowUpDate\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"recordStatus\", \"label\": \"随访状态\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\", \"IN\"], \"sourceField\": \"followUp.recordStatus\"}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"aggravatedCount\", \"label\": \"加重数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel = 'AGGRAVATED' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"completedCount\", \"label\": \"已完成数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.recordStatus = 'COMPLETED' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"completionRatio\", \"label\": \"完成率\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(CASE WHEN followUp.recordStatus = 'COMPLETED' THEN 1 ELSE 0 END) / NULLIF(COUNT(followUp.followUpNo), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"0.00%\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"curedCount\", \"label\": \"痊愈数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel = 'CURED' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"visit.deptCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"doctorId\", \"label\": \"接诊医师\", \"dataType\": \"String\", \"sourceExpression\": \"visit.doctorId\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"effectiveCount\", \"label\": \"有效数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel = 'EFFECTIVE' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"effectiveRatio\", \"label\": \"有效率\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel IN ('CURED', 'MARKED_EFFECT', 'EFFECTIVE') THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN followUp.recordStatus = 'COMPLETED' THEN 1 ELSE 0 END), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"0.00%\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"ineffectiveCount\", \"label\": \"无效数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel = 'INEFFECTIVE' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"lostCount\", \"label\": \"已失访数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.recordStatus = 'LOST' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"lostRatio\", \"label\": \"失访率\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(CASE WHEN followUp.recordStatus = 'LOST' THEN 1 ELSE 0 END) / NULLIF(COUNT(followUp.followUpNo), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"0.00%\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"markedEffectCount\", \"label\": \"显效数\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN followUp.efficacyLevel = 'MARKED_EFFECT' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"plannedCount\", \"label\": \"计划随访数\", \"dataType\": \"Integer\", \"sourceExpression\": \"followUp.followUpNo\", \"aggregateFunction\": \"COUNT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "{\"name\": \"statPeriod\", \"label\": \"统计期间\", \"dataType\": \"Date\", \"sourceExpression\": \"DATE_TRUNC(followUp.plannedFollowUpDate, MONTH)\", \"aggregateFunction\": \"NONE\", \"format\": \"yyyy-MM\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:sourceObject tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "AGG-FOLLOWUP-001 (主表)")
AnnotationAssertion(tcm:sourceObject tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "AGG-PATIENT-001")
AnnotationAssertion(tcm:sourceObject tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "AGG-VISIT-001")
AnnotationAssertion(rdfs:comment tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "统计复诊随访的完成率、失访率与疗效分布，评估治疗依从性与疗效；底部合计"@zh)
AnnotationAssertion(rdfs:label tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "followUpCompletion"@en)
AnnotationAssertion(rdfs:label tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "随访完成与失访分析"@zh)
AnnotationAssertion(skos:notation tcm:Report_RPT_FOLLOWUP_COMPLETION_001 "RPT-FOLLOWUP-COMPLETION-001")
ClassAssertion(tcm:Report tcm:Report_RPT_FOLLOWUP_COMPLETION_001)

# Individual: tcm:Report_RPT_HERB_USAGE_001 (herbUsageStats)

AnnotationAssertion(tcm:behaviorRef tcm:Report_RPT_HERB_USAGE_001 "Prescription_QueryHerbUsage")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_HERB_USAGE_001 "herb.herbCategory")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_HERB_USAGE_001 "herb.herbCode")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_HERB_USAGE_001 "herb.herbName")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_HERB_USAGE_001 "herb.toxicityLevel")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.deptCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaTemplateId\", \"label\": \"方剂模板\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"formula.formulaCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"herbCategory\", \"label\": \"饮片类别\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.herbCategory\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"herbId\", \"label\": \"饮片\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"EQ\", \"IN\"], \"sourceField\": \"herb.herbCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"prescribeDateFrom\", \"label\": \"开方日期起\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_START\", \"allowedOperators\": [\"GE\"], \"sourceField\": \"prescription.prescribeTime\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"prescribeDateTo\", \"label\": \"开方日期止\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_END\", \"allowedOperators\": [\"LE\"], \"sourceField\": \"prescription.prescribeTime\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"prescriptionType\", \"label\": \"处方类型\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"prescription.prescriptionType\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"statsDimension\", \"label\": \"统计维度\", \"dataType\": \"Enum\", \"required\": false, \"defaultValue\": \"HERB\", \"enumValues\": [\"HERB\", \"FORMULA_TEMPLATE\"], \"allowedOperators\": [\"EQ\"], \"sourceField\": \"itemAgg.herbId\"}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"avgSingleDose\", \"label\": \"单剂平均用量（g）\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(itemAgg.doseSum * prescription.doses) / NULLIF(SUM(prescription.doses), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"doseCount\", \"label\": \"使用剂数\", \"dataType\": \"Integer\", \"sourceExpression\": \"prescription.doses\", \"aggregateFunction\": \"SUM\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaCode\", \"label\": \"方剂编码\", \"dataType\": \"String\", \"sourceExpression\": \"formula.formulaCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaName\", \"label\": \"方剂名称\", \"dataType\": \"String\", \"sourceExpression\": \"formula.formulaName\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaRefCount\", \"label\": \"引用张数\", \"dataType\": \"Integer\", \"sourceExpression\": \"prescription.prescriptionNo\", \"aggregateFunction\": \"COUNT_DISTINCT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaRefRatio\", \"label\": \"引用占比\", \"dataType\": \"Decimal\", \"sourceExpression\": \"COUNT(DISTINCT prescription.prescriptionNo) / NULLIF(SUBTOTAL(COUNT(DISTINCT prescription.prescriptionNo)), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"0.00%\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"formulaType\", \"label\": \"方剂类型\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"formula.formulaType\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"herbCategory\", \"label\": \"药材类别\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"herb.herbCategory\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"herbCode\", \"label\": \"饮片编码\", \"dataType\": \"String\", \"sourceExpression\": \"herb.herbCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"herbName\", \"label\": \"饮片名称\", \"dataType\": \"String\", \"sourceExpression\": \"herb.herbName\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"patientCount\", \"label\": \"涉及患者数\", \"dataType\": \"Integer\", \"sourceExpression\": \"prescription.patientId\", \"aggregateFunction\": \"COUNT_DISTINCT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"prescriptionCount\", \"label\": \"涉及处方张数\", \"dataType\": \"Integer\", \"sourceExpression\": \"prescription.prescriptionNo\", \"aggregateFunction\": \"COUNT_DISTINCT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"totalQuantity\", \"label\": \"累计用量（g）\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(itemAgg.doseSum * prescription.doses)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_HERB_USAGE_001 "{\"name\": \"toxicityLevel\", \"label\": \"毒性分级\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"herb.toxicityLevel\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
