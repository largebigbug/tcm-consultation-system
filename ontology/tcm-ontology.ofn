# Individual: tcm:Report_QR_HERB_STOCK_001 (饮片库存与预警查询)

AnnotationAssertion(tcm:behaviorRef tcm:Report_QR_HERB_STOCK_001 "Herb_QueryStockAndAlert")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbCategory\", \"label\": \"药材类别\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.herbCategory\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbCode\", \"label\": \"饮片编码\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.herbCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbName\", \"label\": \"饮片名称\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"LIKE\"], \"sourceField\": \"herb.herbName\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbStatus\", \"label\": \"状态\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.herbStatus\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"onlyAlert\", \"label\": \"仅看预警项\", \"dataType\": \"Boolean\", \"required\": false, \"defaultValue\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.stockQuantity\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"stockQuantityFrom\", \"label\": \"库存数量下限（g）\", \"dataType\": \"Decimal\", \"required\": false, \"allowedOperators\": [\"GE\"], \"sourceField\": \"herb.stockQuantity\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"stockQuantityTo\", \"label\": \"库存数量上限（g）\", \"dataType\": \"Decimal\", \"required\": false, \"allowedOperators\": [\"LE\"], \"sourceField\": \"herb.stockQuantity\"}")
AnnotationAssertion(tcm:parameter tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"toxicityLevel\", \"label\": \"毒性分级\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"herb.toxicityLevel\"}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"alertGap\", \"label\": \"预警差额（g）\", \"dataType\": \"Decimal\", \"sourceExpression\": \"herb.lowStockThreshold - herb.stockQuantity\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"alertStatus\", \"label\": \"预警状态\", \"dataType\": \"String\", \"sourceExpression\": \"CASE WHEN herb.stockQuantity < herb.lowStockThreshold THEN '预警' ELSE '正常' END\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"aliasName\", \"label\": \"别名\", \"dataType\": \"String\", \"sourceExpression\": \"herb.aliasName\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbCategory\", \"label\": \"药材类别\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"herb.herbCategory\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbCode\", \"label\": \"饮片编码\", \"dataType\": \"String\", \"sourceExpression\": \"herb.herbCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"herbName\", \"label\": \"饮片名称\", \"dataType\": \"String\", \"sourceExpression\": \"herb.herbName\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"latestInboundDate\", \"label\": \"最近入库日期\", \"dataType\": \"DateTime\", \"sourceExpression\": \"flowAgg.latestInboundDate\", \"aggregateFunction\": \"NONE\", \"format\": \"yyyy-MM-dd\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"latestOutboundDate\", \"label\": \"最近出库日期\", \"dataType\": \"DateTime\", \"sourceExpression\": \"flowAgg.latestOutboundDate\", \"aggregateFunction\": \"NONE\", \"format\": \"yyyy-MM-dd\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"lowStockThreshold\", \"label\": \"低库存预警值\", \"dataType\": \"Decimal\", \"sourceExpression\": \"herb.lowStockThreshold\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": true, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"maxCommonDose\", \"label\": \"常用最大量\", \"dataType\": \"Decimal\", \"sourceExpression\": \"herb.maxCommonDose\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"minCommonDose\", \"label\": \"常用最小量\", \"dataType\": \"Decimal\", \"sourceExpression\": \"herb.minCommonDose\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"origin\", \"label\": \"产地\", \"dataType\": \"String\", \"sourceExpression\": \"herb.origin\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": true, \"visible\": true, \"sortable\": false}")
