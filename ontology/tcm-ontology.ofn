AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"stockQuantity\", \"label\": \"库存数量（g）\", \"dataType\": \"Decimal\", \"sourceExpression\": \"herb.stockQuantity\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0.00\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_QR_HERB_STOCK_001 "{\"name\": \"toxicityLevel\", \"label\": \"毒性分级\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"herb.toxicityLevel\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
