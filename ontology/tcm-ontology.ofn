# Individual: tcm:Rule_RULE_FOLLOWUP_DATE_ORDER (复诊日期顺序校验)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "\"actualFollowUpDate >= DATE(sourceVisitRegisterTime)\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "{\"name\": \"actualFollowUpDate\", \"type\": \"Date\", \"sourceField\": \"FollowUp.actualFollowUpDate\", \"required\": true}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "{\"name\": \"sourceVisitRegisterTime\", \"type\": \"DateTime\", \"sourceField\": \"Visit.registerTime\", \"required\": true, \"description\": \"上次就诊（随访来源）的挂号时间\"}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "Boolean")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "FollowUp_Complete")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "实际随访日期不得早于随访来源就诊的挂号时间；违反时提示并要求修正（D-17）。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "复诊日期顺序校验"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_FOLLOWUP_DATE_ORDER "RULE-FOLLOWUP-DATE-ORDER")
ClassAssertion(tcm:Rule tcm:Rule_RULE_FOLLOWUP_DATE_ORDER)

# Individual: tcm:Rule_RULE_HERB_STOCK_RECONCILE (饮片库存对账校验)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_HERB_STOCK_RECONCILE "\"stockQuantity - flowNetQuantity\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_STOCK_RECONCILE "{\"name\": \"flowNetQuantity\", \"type\": \"Decimal\", \"sourceField\": \"SUM(HerbStockFlow.quantity)\", \"required\": true, \"description\": \"该饮片全部出入库流水数量净和（g）\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_STOCK_RECONCILE "{\"name\": \"stockQuantity\", \"type\": \"Decimal\", \"sourceField\": \"Herb.stockQuantity\", \"required\": true}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_HERB_STOCK_RECONCILE "Decimal")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_HERB_STOCK_RECONCILE "Herb_Stocktake")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_HERB_STOCK_RECONCILE "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_HERB_STOCK_RECONCILE "盘点时以饮片库存数量与全部出入库流水数量净和比对，输出对账结论与差异值（不阻断业务，供盘点人员据以发起盘点调整）。
与 M1 聚合不变量 INV-03 同源：INV-03 为写入时强制的聚合不变量，本规则为盘点行为的对账判定与差异呈现。依据 INV-03。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_HERB_STOCK_RECONCILE "饮片库存对账校验"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_HERB_STOCK_RECONCILE "RULE-HERB-STOCK-RECONCILE")
ClassAssertion(tcm:Rule tcm:Rule_RULE_HERB_STOCK_RECONCILE)

# Individual: tcm:Rule_RULE_HERB_STOCK_SUFFICIENT (饮片库存充足校验)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "\"FOR EACH item IN prescriptionItems:\\n  IF item.singleDose * prescription.doses > herb(item.herbId).stockQuantity THEN RETURN false\\nRETURN true\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "{\"name\": \"requiredQuantity\", \"type\": \"Decimal\", \"sourceField\": \"PrescriptionItem.singleDose * Prescription.doses\", \"required\": true, \"description\": \"该味饮片需求总量 = 单剂剂量 × 剂数（g）\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "{\"name\": \"stockQuantity\", \"type\": \"Decimal\", \"sourceField\": \"Herb.stockQuantity\", \"required\": true, \"description\": \"饮片当前库存数量（g）\"}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "Boolean")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "Dispense_Confirm")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "按处方剂数计算各味饮片需求总量，逐味比对饮片当前库存数量，任一味不足则阻断调剂（D-14）。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "饮片库存充足校验"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_HERB_STOCK_SUFFICIENT "RULE-HERB-STOCK-SUFFICIENT")
ClassAssertion(tcm:Rule tcm:Rule_RULE_HERB_STOCK_SUFFICIENT)

# Individual: tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK (毒性饮片处方总量上限校验)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "\"IF toxicityLevel == 'NONE' THEN RETURN true\\nIF toxicDoseLimit IS NULL THEN RETURN true\\nRETURN totalDoseInPrescription <= toxicDoseLimit\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "{\"name\": \"herbId\", \"type\": \"String\", \"sourceField\": \"PrescriptionItem.herbId\", \"required\": true}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "{\"name\": \"totalDoseInPrescription\", \"type\": \"Decimal\", \"sourceField\": \"SUM(PrescriptionItem.singleDose)\", \"required\": true, \"description\": \"同一处方内该味饮片的单剂总量（g）\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "{\"name\": \"toxicDoseLimit\", \"type\": \"Decimal\", \"sourceField\": \"Herb.toxicDoseLimit\", \"required\": false, \"description\": \"毒性单张处方总量上限（g），为空表示不单独设限\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "{\"name\": \"toxicityLevel\", \"type\": \"String\", \"sourceField\": \"Herb.toxicityLevel\", \"required\": true, \"description\": \"毒性分级字典值，NONE 表示无毒\"}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "Boolean")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "Prescription_Submit")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "对处方内毒性分级非「无毒」的饮片，按单剂剂量汇总同味饮片总量，与饮片维护的「毒性单张处方总量上限」比对，
超上限即阻断提交；未维护上限的毒性饮片只做强制审核提示。依据 D-11。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "毒性饮片处方总量上限校验"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK "RULE-HERB-TOXIC-TOTAL-LIMIT-CHECK")
ClassAssertion(tcm:Rule tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK)

# Individual: tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK (剂量超常用量上限处理判定)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "\"IF singleDose <= maxCommonDose THEN 'PASS'\\nELSE IF singleDose > maxCommonDose * 2 THEN 'BLOCK'\\nELSE IF overDoseReason IS NULL OR LENGTH(overDoseReason) == 0 THEN 'NEED_REASON'\\nELSE 'NEED_REASON'\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "{\"name\": \"maxCommonDose\", \"type\": \"Decimal\", \"sourceField\": \"Herb.maxCommonDose\", \"required\": true, \"description\": \"饮片常用最大量（g）\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "{\"name\": \"minCommonDose\", \"type\": \"Decimal\", \"sourceField\": \"Herb.minCommonDose\", \"required\": true, \"description\": \"饮片常用最小量（g）\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "{\"name\": \"overDoseReason\", \"type\": \"String\", \"sourceField\": \"PrescriptionItem.overDoseReason\", \"required\": false, \"description\": \"超量理由，超常用上限时必填\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "{\"name\": \"singleDose\", \"type\": \"Decimal\", \"sourceField\": \"PrescriptionItem.singleDose\", \"required\": true, \"description\": \"处方明细单剂剂量（g）\"}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "String")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "Prescription_Save")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "Prescription_Submit")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "读取处方明细的单剂剂量与所引饮片的常用量区间，判定三种处理结论：
PASS（未超常用上限，正常放行）/ NEED_REASON（超常用上限但在 2 倍以内，必须填写超量理由并强制药师审核）/
BLOCK（超过常用上限 2 倍，直接阻断提交）。依据 D-11、D-16。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "剂量超常用量上限处理判定"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK "RULE-PRESCRIPTION-DOSE-LIMIT-CHECK")
ClassAssertion(tcm:Rule tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK)

# Individual: tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH (处方作废处理判定与阻断)

AnnotationAssertion(tcm:expression tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "\"IF recordStatus IS NULL THEN RETURN 'VOID_ONLY'\\nIF recordStatus == 'PENDING' THEN RETURN 'VOID_ONLY'\\nIF recordStatus == 'DISPENSED' THEN RETURN 'VOID_WITH_ROLLBACK'\\nIF recordStatus == 'ISSUED' THEN RETURN 'BLOCK'\\nRETURN 'VOID_ONLY'\"")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "{\"name\": \"prescriptionStatus\", \"type\": \"String\", \"sourceField\": \"Prescription.prescriptionStatus\", \"required\": true, \"description\": \"当前处方状态\"}")
AnnotationAssertion(tcm:inputParam tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "{\"name\": \"recordStatus\", \"type\": \"String\", \"sourceField\": \"DispenseRecord.recordStatus\", \"required\": false, \"description\": \"调剂发药记录状态；无记录时为空\"}")
AnnotationAssertion(tcm:outputType tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "String")
AnnotationAssertion(tcm:reusedByBehavior tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "Prescription_Cancel")
AnnotationAssertion(tcm:ruleType tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "VALIDATION")
AnnotationAssertion(rdfs:comment tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "按调剂发药记录状态三分派：无记录或「待调剂」→ VOID_ONLY（允许作废，无库存动作，同步取消待调剂记录）；
「已调剂」→ VOID_WITH_ROLLBACK（允许作废并按 B-02 回冲库存）；「已发药」→ BLOCK（阻断作废，
退药走线下处理）。规则只判断与分派，状态变化由行为完成。依据 D-08、D-19。"@zh)
AnnotationAssertion(rdfs:label tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "处方作废处理判定与阻断"@zh)
AnnotationAssertion(skos:notation tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH "RULE-PRESCRIPTION-VOID-DISPATCH")
ClassAssertion(tcm:Rule tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH)

