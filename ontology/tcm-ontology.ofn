# Individual: tcm:Report_RPT_VISIT_STATS_001 (visitStats)

AnnotationAssertion(tcm:behaviorRef tcm:Report_RPT_VISIT_STATS_001 "Visit_QueryStats")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_VISIT_STATS_001 "DATE_TRUNC(visit.registerTime, granularity)")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_VISIT_STATS_001 "visit.deptCode")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_VISIT_STATS_001 "visit.doctorId")
AnnotationAssertion(tcm:groupBy tcm:Report_RPT_VISIT_STATS_001 "visit.visitType")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.deptCode\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"doctorId\", \"label\": \"接诊医师\", \"dataType\": \"String\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.doctorId\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"granularity\", \"label\": \"日期粒度\", \"dataType\": \"Enum\", \"required\": false, \"defaultValue\": \"DAY\", \"enumValues\": [\"DAY\", \"MONTH\"], \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.registerTime\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"registerDateFrom\", \"label\": \"挂号日期起\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_START\", \"allowedOperators\": [\"GE\"], \"sourceField\": \"visit.registerTime\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"registerDateTo\", \"label\": \"挂号日期止\", \"dataType\": \"Date\", \"required\": false, \"defaultValue\": \"MONTH_END\", \"allowedOperators\": [\"LE\"], \"sourceField\": \"visit.registerTime\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"visitStatus\", \"label\": \"就诊状态\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.visitStatus\"}")
AnnotationAssertion(tcm:parameter tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"visitType\", \"label\": \"就诊类型\", \"dataType\": \"Enum\", \"required\": false, \"allowedOperators\": [\"EQ\"], \"sourceField\": \"visit.visitType\"}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"cancelledCount\", \"label\": \"已取消人次\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN visit.visitStatus = 'CANCELLED' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"completedCount\", \"label\": \"已完成人次\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN visit.visitStatus = 'COMPLETED' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"visit.deptCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"doctorId\", \"label\": \"接诊医师\", \"dataType\": \"String\", \"sourceExpression\": \"visit.doctorId\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"firstVisitCount\", \"label\": \"初诊人次\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN visit.visitType = 'FIRST' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"followUpRatio\", \"label\": \"复诊占比\", \"dataType\": \"Decimal\", \"sourceExpression\": \"SUM(CASE WHEN visit.visitType = 'FOLLOW_UP' THEN 1 ELSE 0 END) / NULLIF(COUNT(visit.visitNo), 0)\", \"aggregateFunction\": \"NONE\", \"format\": \"0.00%\", \"nullable\": true, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"followUpVisitCount\", \"label\": \"复诊人次\", \"dataType\": \"Integer\", \"sourceExpression\": \"SUM(CASE WHEN visit.visitType = 'FOLLOW_UP' THEN 1 ELSE 0 END)\", \"aggregateFunction\": \"NONE\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"patientCount\", \"label\": \"就诊人数\", \"dataType\": \"Integer\", \"sourceExpression\": \"visit.patientId\", \"aggregateFunction\": \"COUNT_DISTINCT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": false}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"statDate\", \"label\": \"统计日期\", \"dataType\": \"Date\", \"sourceExpression\": \"DATE_TRUNC(visit.registerTime, granularity)\", \"aggregateFunction\": \"NONE\", \"format\": \"yyyy-MM-dd\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"visitCount\", \"label\": \"就诊人次\", \"dataType\": \"Integer\", \"sourceExpression\": \"visit.visitNo\", \"aggregateFunction\": \"COUNT\", \"format\": \"#,##0\", \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:resultColumn tcm:Report_RPT_VISIT_STATS_001 "{\"name\": \"visitType\", \"label\": \"就诊类型\", \"dataType\": \"Enum\", \"sourceExpression\": \"visit.visitType\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}")
AnnotationAssertion(tcm:sourceObject tcm:Report_RPT_VISIT_STATS_001 "AGG-PATIENT-001")
AnnotationAssertion(tcm:sourceObject tcm:Report_RPT_VISIT_STATS_001 "AGG-VISIT-001 (主表)")
