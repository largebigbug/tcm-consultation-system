AnnotationAssertion(rdfs:label tcm:Report_RPT_VISIT_STATS_001 "visitStats"@en)
AnnotationAssertion(rdfs:label tcm:Report_RPT_VISIT_STATS_001 "门诊量统计"@zh)
AnnotationAssertion(skos:notation tcm:Report_RPT_VISIT_STATS_001 "RPT-VISIT-STATS-001")
