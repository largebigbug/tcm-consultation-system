# 中医问诊系统本体 · M6 流程模型 分片（由 tools/ontology_extras.py 从主文件拆分）
# 用途：分工维护与评审。完整导入 WebProtégé 请用上级目录的 tcm-ontology.ttl

@prefix tcm:  <http://hermes.local/tcm-ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

tcm:ontology
    a owl:Ontology ;
    rdfs:label "中医问诊系统本体"@zh ;
    rdfs:comment "由 7 个本体模型（M1/M2/M3/M5/M6/M7/MU）机械生成；领域：中医问诊"@zh ;
    dcterms:source "中医问诊系统-需求规格说明书-V9" ;
    owl:versionInfo "2.1" .

tcm:Aggregate
    a owl:Class ;
    rdfs:label "聚合根"@zh ;
    rdfs:comment "可独立存在的业务对象（M1 聚合根）"@zh .

tcm:Enumeration
    a owl:Class ;
    rdfs:label "枚举字典"@zh ;
    rdfs:comment "M1 数据字典中的取值类型"@zh .

tcm:Role
    a owl:Class ;
    rdfs:label "角色"@zh ;
    rdfs:comment "M5 角色（权限集合）"@zh .

tcm:Actor
    a owl:Class ;
    rdfs:label "人员/主体"@zh ;
    rdfs:comment "M5 参与者（人）"@zh .

tcm:Behavior
    a owl:Class ;
    rdfs:label "行为"@zh ;
    rdfs:comment "M2 行为（命令/查询等）"@zh .

tcm:Permission
    a owl:Class ;
    rdfs:label "权限"@zh ;
    rdfs:comment "M5 权限项（行为级 + 数据范围）"@zh .

tcm:Rule
    a owl:Class ;
    rdfs:label "业务规则"@zh ;
    rdfs:comment "M3 规则（校验/计算/分派）"@zh .

tcm:Flow
    a owl:Class ;
    rdfs:label "流程"@zh ;
    rdfs:comment "M6 流程定义"@zh .

tcm:FlowActivity
    a owl:Class ;
    rdfs:label "流程活动"@zh ;
    rdfs:comment "M6 流程内的活动节点"@zh .

tcm:Report
    a owl:Class ;
    rdfs:label "报表"@zh ;
    rdfs:comment "M7 查询与报表"@zh .

tcm:Screen
    a owl:Class ;
    rdfs:label "界面"@zh ;
    rdfs:comment "MU 屏幕"@zh .

tcm:grantsPermission
    a owl:ObjectProperty ;
    rdfs:domain tcm:Role ;
    rdfs:range tcm:Permission ;
    rdfs:label "角色授予权限"@zh .

tcm:hasRole
    a owl:ObjectProperty ;
    rdfs:domain tcm:Actor ;
    rdfs:range tcm:Role ;
    rdfs:label "人员具有角色"@zh .

tcm:appliesRule
    a owl:ObjectProperty ;
    rdfs:domain tcm:Behavior ;
    rdfs:range tcm:Rule ;
    rdfs:label "行为适用规则"@zh .

tcm:hasActivity
    a owl:ObjectProperty ;
    rdfs:domain tcm:Flow ;
    rdfs:range tcm:FlowActivity ;
    rdfs:label "流程包含活动"@zh .

tcm:lifecycle
    a owl:AnnotationProperty ;
    rdfs:label "生命周期"@zh .

tcm:required
    a owl:AnnotationProperty ;
    rdfs:label "是否必填"@zh .

tcm:unique
    a owl:AnnotationProperty ;
    rdfs:label "是否唯一"@zh .

tcm:defaultValue
    a owl:AnnotationProperty ;
    rdfs:label "默认值"@zh .

tcm:dictionaryId
    a owl:AnnotationProperty ;
    rdfs:label "所属字典"@zh .

tcm:sortOrder
    a owl:AnnotationProperty ;
    rdfs:label "排序"@zh .

tcm:inverseLabel
    a owl:AnnotationProperty ;
    rdfs:label "反向角色名"@zh .

tcm:cardinality
    a owl:AnnotationProperty ;
    rdfs:label "基数"@zh .

tcm:referenceField
    a owl:AnnotationProperty ;
    rdfs:label "引用字段"@zh .

tcm:targetType
    a owl:AnnotationProperty ;
    rdfs:label "目标类型"@zh .

tcm:dataScope
    a owl:AnnotationProperty ;
    rdfs:label "数据范围"@zh .

tcm:actorType
    a owl:AnnotationProperty ;
    rdfs:label "主体类型"@zh .

tcm:behaviorType
    a owl:AnnotationProperty ;
    rdfs:label "行为类型"@zh .

tcm:triggerType
    a owl:AnnotationProperty ;
    rdfs:label "触发方式"@zh .

tcm:ownerEntity
    a owl:AnnotationProperty ;
    rdfs:label "所属实体ID"@zh .

tcm:ownerEntityName
    a owl:AnnotationProperty ;
    rdfs:label "所属实体"@zh .

tcm:precondition
    a owl:AnnotationProperty ;
    rdfs:label "前置条件"@zh .

tcm:postcondition
    a owl:AnnotationProperty ;
    rdfs:label "后置条件"@zh .

tcm:appliedRule
    a owl:AnnotationProperty ;
    rdfs:label "适用规则ID"@zh .

tcm:ruleType
    a owl:AnnotationProperty ;
    rdfs:label "规则类型"@zh .

tcm:outputType
    a owl:AnnotationProperty ;
    rdfs:label "输出类型"@zh .

tcm:expression
    a owl:AnnotationProperty ;
    rdfs:label "规则表达式"@zh .

tcm:inputParam
    a owl:AnnotationProperty ;
    rdfs:label "输入参数"@zh .

tcm:reusedByBehavior
    a owl:AnnotationProperty ;
    rdfs:label "被行为引用"@zh .

tcm:flowType
    a owl:AnnotationProperty ;
    rdfs:label "流程类型"@zh .

tcm:businessObject
    a owl:AnnotationProperty ;
    rdfs:label "涉及业务对象"@zh .

tcm:involvedRole
    a owl:AnnotationProperty ;
    rdfs:label "涉及角色"@zh .

tcm:startActivity
    a owl:AnnotationProperty ;
    rdfs:label "起始活动"@zh .

tcm:endActivity
    a owl:AnnotationProperty ;
    rdfs:label "结束活动"@zh .

tcm:performer
    a owl:AnnotationProperty ;
    rdfs:label "执行角色"@zh .

tcm:activityType
    a owl:AnnotationProperty ;
    rdfs:label "活动类型"@zh .

tcm:behaviorRef
    a owl:AnnotationProperty ;
    rdfs:label "对应行为"@zh .

tcm:sourceObject
    a owl:AnnotationProperty ;
    rdfs:label "来源对象"@zh .

tcm:resultColumn
    a owl:AnnotationProperty ;
    rdfs:label "结果列"@zh .

tcm:parameter
    a owl:AnnotationProperty ;
    rdfs:label "参数"@zh .

tcm:groupBy
    a owl:AnnotationProperty ;
    rdfs:label "分组字段"@zh .

tcm:screenType
    a owl:AnnotationProperty ;
    rdfs:label "屏幕类型"@zh .

tcm:elementCount
    a owl:AnnotationProperty ;
    rdfs:label "元素数"@zh .

tcm:actionCount
    a owl:AnnotationProperty ;
    rdfs:label "动作数"@zh .

tcm:Flow_FLOW_VISIT_001
    a owl:NamedIndividual ;
    a tcm:Flow ;
    rdfs:label "门诊问诊开方主流程"@zh ;
    skos:notation "FLOW-VISIT-001" ;
    tcm:flowType "COLLABORATION" ;
    rdfs:comment "完成一名患者从建档挂号、四诊采集、辨证开方、处方审核到调剂发药的全过程"@zh ;
    tcm:businessObject "AGG-PATIENT-001" ;
    tcm:businessObject "AGG-VISIT-001" ;
    tcm:businessObject "AGG-DIAGNOSIS-001" ;
    tcm:businessObject "AGG-FORMULA-001" ;
    tcm:businessObject "AGG-PRESCRIPTION-001" ;
    tcm:businessObject "AGG-HERB-001" ;
    tcm:businessObject "AGG-DISPENSE-001" ;
    tcm:businessObject "AGG-FOLLOWUP-001" ;
    tcm:involvedRole "ROLE-01" ;
    tcm:involvedRole "ROLE-02" ;
    tcm:involvedRole "ROLE-03" ;
    tcm:involvedRole "ROLE-05" ;
    tcm:startActivity "A01" ;
    tcm:endActivity "E01" ;
    tcm:endActivity "E02" ;
    tcm:endActivity "E03" ;
    tcm:endActivity "E04" .

tcm:Activity_FLOW_VISIT_001_A01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "开始（患者到达门诊）"@zh ;
    skos:notation "A01" ;
    tcm:activityType "START" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A01 .

tcm:Activity_FLOW_VISIT_001_A02
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "患者建档（老患者跳过）"@zh ;
    skos:notation "A02" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A02 .

tcm:Activity_FLOW_VISIT_001_A03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "门诊挂号"@zh ;
    skos:notation "A03" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A03 .

tcm:Activity_FLOW_VISIT_001_A04
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "接诊开单"@zh ;
    skos:notation "A04" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A04 .

tcm:Activity_FLOW_VISIT_001_A05
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "录入四诊信息"@zh ;
    skos:notation "A05" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A05 .

tcm:Activity_FLOW_VISIT_001_A06
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "辨证判定并确认结论"@zh ;
    skos:notation "A06" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A06 .

tcm:Activity_FLOW_VISIT_001_A07
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "开具处方（可引用方剂模板）"@zh ;
    skos:notation "A07" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A07 .

tcm:Activity_FLOW_VISIT_001_A08
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "提交处方送审"@zh ;
    skos:notation "A08" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A08 .

tcm:Activity_FLOW_VISIT_001_G01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "剂量超常用量上限判定"@zh ;
    skos:notation "G01" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G01 .

tcm:Activity_FLOW_VISIT_001_G02
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "毒性饮片单张处方总量判定"@zh ;
    skos:notation "G02" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G02 .

tcm:Activity_FLOW_VISIT_001_A09
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "就诊状态收尾"@zh ;
    skos:notation "A09" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-04；由 A08 提交成功经 syncTriggers 同步执行，流程仅标注联动结果活动"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A09 .

tcm:Activity_FLOW_VISIT_001_A10
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "生成复诊随访记录"@zh ;
    skos:notation "A10" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-03；由 A09 经 syncTriggers 同步执行；计划随访日期 = 就诊日 + 剂数 × 1 天"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A10 .

tcm:Activity_FLOW_VISIT_001_A11
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "中药处方审核"@zh ;
    skos:notation "A11" ;
    tcm:activityType "SUB_FLOW_CALL" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A11 .

tcm:Activity_FLOW_VISIT_001_G03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "处方审核结果判定"@zh ;
    skos:notation "G03" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G03 .

tcm:Activity_FLOW_VISIT_001_A12
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "创建待调剂记录"@zh ;
    skos:notation "A12" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-05；审核通过后生成待调剂记录（药剂师调剂入口）"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A12 .

tcm:Activity_FLOW_VISIT_001_A13
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "确认调剂（按明细配齐饮片）"@zh ;
    skos:notation "A13" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-03" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A13 .

tcm:Activity_FLOW_VISIT_001_G04
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "饮片库存充足性判定"@zh ;
    skos:notation "G04" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G04 .

tcm:Activity_FLOW_VISIT_001_A14
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "发药确认（与患者核对交接）"@zh ;
    skos:notation "A14" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-03" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A14 .

tcm:Activity_FLOW_VISIT_001_A15
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "处方作废（未调剂前）"@zh ;
    skos:notation "A15" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A15 .

tcm:Activity_FLOW_VISIT_001_G05
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "处方作废处理判定"@zh ;
    skos:notation "G05" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G05 .

tcm:Activity_FLOW_VISIT_001_A16
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "饮片库存回冲"@zh ;
    skos:notation "A16" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-02；由 A15 经 R-04 判定的 syncTriggers 同步执行，生成作废回冲流水"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A16 .

tcm:Activity_FLOW_VISIT_001_A17
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "撤销就诊（患者未就诊或误挂号）"@zh ;
    skos:notation "A17" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A17 .

tcm:Activity_FLOW_VISIT_001_A18
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "取消待调剂记录"@zh ;
    skos:notation "A18" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-06；由 A15 经 R-04 判定的 syncTriggers 同步执行"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A18 .

tcm:Activity_FLOW_VISIT_001_E01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "异常终止（调剂阻断：饮片库存不足）"@zh ;
    skos:notation "E01" ;
    tcm:activityType "END" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_E01 .

tcm:Activity_FLOW_VISIT_001_E02
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "正常结束（处方已发药）"@zh ;
    skos:notation "E02" ;
    tcm:activityType "END" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_E02 .

tcm:Activity_FLOW_VISIT_001_E03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "异常终止（处方已作废）"@zh ;
    skos:notation "E03" ;
    tcm:activityType "END" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_E03 .

tcm:Activity_FLOW_VISIT_001_E04
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "阻断（处方已发药，不可作废）"@zh ;
    skos:notation "E04" ;
    tcm:activityType "END" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_E04 .

tcm:Activity_FLOW_VISIT_001_E05
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "异常终止（就诊已取消）"@zh ;
    skos:notation "E05" ;
    tcm:activityType "END" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_E05 .

tcm:Flow_FLOW_FOLLOWUP_001
    a owl:NamedIndividual ;
    a tcm:Flow ;
    rdfs:label "复诊调方流程"@zh ;
    skos:notation "FLOW-FOLLOWUP-001" ;
    tcm:flowType "COLLABORATION" ;
    rdfs:comment "基于上次就诊的疗效评价完成调方，并闭合随访管理"@zh ;
    tcm:businessObject "AGG-PATIENT-001" ;
    tcm:businessObject "AGG-VISIT-001" ;
    tcm:businessObject "AGG-DIAGNOSIS-001" ;
    tcm:businessObject "AGG-PRESCRIPTION-001" ;
    tcm:businessObject "AGG-HERB-001" ;
    tcm:businessObject "AGG-DISPENSE-001" ;
    tcm:businessObject "AGG-FOLLOWUP-001" ;
    tcm:involvedRole "ROLE-01" ;
    tcm:involvedRole "ROLE-02" ;
    tcm:involvedRole "ROLE-03" ;
    tcm:involvedRole "ROLE-05" ;
    tcm:startActivity "P01" ;
    tcm:endActivity "E01" ;
    tcm:endActivity "E02" ;
    tcm:endActivity "E03" ;
    tcm:endActivity "E04" .

tcm:Activity_FLOW_FOLLOWUP_001_P01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "开始（存在待随访记录或复诊挂号）"@zh ;
    skos:notation "P01" ;
    tcm:activityType "START" .

tcm:Flow_FLOW_FOLLOWUP_001
    tcm:hasActivity tcm:Activity_FLOW_FOLLOWUP_001_P01 .

tcm:Activity_FLOW_FOLLOWUP_001_P02
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "复诊挂号并关联上次就诊"@zh ;
    skos:notation "P02" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_FOLLOWUP_001
    tcm:hasActivity tcm:Activity_FLOW_FOLLOWUP_001_P02 .

tcm:Activity_FLOW_FOLLOWUP_001_P03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "选择待随访记录并回填本次就诊"@zh ;
    skos:notation "P03" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" ;
    rdfs:comment "挂号环节将随访记录的「本次就诊」回填为本次就诊（ActualVisitId）；\n疗效评价与记录置「已完成」在 P06 由同一行为第二次执行时收口"@zh .

tcm:Flow_FLOW_FOLLOWUP_001
    tcm:hasActivity tcm:Activity_FLOW_FOLLOWUP_001_P03 .

tcm:Activity_FLOW_FOLLOWUP_001_G01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "随访日期顺序判定"@zh ;
    skos:notation "G01" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_FOLLOWUP_001
    tcm:hasActivity tcm:Activity_FLOW_FOLLOWUP_001_G01 .

