tcm:Screen_frmVisitStats
    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "门诊量统计"@zh ;
    skos:notation "frmVisitStats" ;
    tcm:screenType "QUERY_LIST" ;
    tcm:elementCount "15" ;
    tcm:actionCount "2" .

tcm:Screen_frmSyndromeDist
    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "证型分布统计"@zh ;
    skos:notation "frmSyndromeDist" ;
    tcm:screenType "QUERY_LIST" ;
