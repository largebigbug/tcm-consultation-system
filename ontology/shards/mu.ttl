    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "处方审核"@zh ;
    skos:notation "frmPrescriptionReview" ;
    tcm:screenType "SINGLE_FORM" ;
    tcm:elementCount "12" ;
    tcm:actionCount "2" .

tcm:Screen_frmDispense
    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "调剂发药"@zh ;
    skos:notation "frmDispense" ;
    tcm:screenType "MASTER_DETAIL_FORM" ;
    tcm:elementCount "13" ;
    tcm:actionCount "2" .

