    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "饮片库存与预警（含盘点）"@zh ;
    skos:notation "frmHerbStock" ;
    tcm:screenType "QUERY_LIST" ;
    tcm:elementCount "25" ;
    tcm:actionCount "3" .

