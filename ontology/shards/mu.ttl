    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "门诊挂号（含撤销就诊）"@zh ;
    skos:notation "frmVisitRegister" ;
    tcm:screenType "SINGLE_FORM" ;
    tcm:elementCount "12" ;
    tcm:actionCount "2" .

