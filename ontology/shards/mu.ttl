# 中医问诊系统本体 · MU 界面模型 分片（由 tools/ontology_extras.py 从主文件拆分）
# 用途：分工维护与评审。完整导入 WebProtégé 请用上级目录的 tcm-ontology.ttl

@prefix tcm:  <http://hermes.local/tcm-ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

tcm:ontology
    a owl:Ontology ;
    rdfs:label "中医问诊系统本体"@zh ;
    rdfs:comment "由 7 个本体模型（M1/M2/M3/M5/M6/M7/MU）机械生成；领域：中医问诊"@zh ;
    dcterms:source "中医问诊系统-需求规格说明书-V9" ;
    owl:versionInfo "2.1" .

tcm:Aggregate
    a owl:Class ;
    rdfs:label "聚合根"@zh ;
    rdfs:comment "可独立存在的业务对象（M1 聚合根）"@zh .

tcm:Enumeration
    a owl:Class ;
    rdfs:label "枚举字典"@zh ;
    rdfs:comment "M1 数据字典中的取值类型"@zh .

tcm:Role
    a owl:Class ;
    rdfs:label "角色"@zh ;
    rdfs:comment "M5 角色（权限集合）"@zh .

tcm:Actor
    a owl:Class ;
    rdfs:label "人员/主体"@zh ;
    rdfs:comment "M5 参与者（人）"@zh .

tcm:Behavior
    a owl:Class ;
    rdfs:label "行为"@zh ;
    rdfs:comment "M2 行为（命令/查询等）"@zh .

tcm:Permission
    a owl:Class ;
    rdfs:label "权限"@zh ;
    rdfs:comment "M5 权限项（行为级 + 数据范围）"@zh .

tcm:Rule
    a owl:Class ;
    rdfs:label "业务规则"@zh ;
    rdfs:comment "M3 规则（校验/计算/分派）"@zh .

tcm:Flow
    a owl:Class ;
    rdfs:label "流程"@zh ;
    rdfs:comment "M6 流程定义"@zh .

tcm:FlowActivity
    a owl:Class ;
    rdfs:label "流程活动"@zh ;
    rdfs:comment "M6 流程内的活动节点"@zh .

tcm:Report
    a owl:Class ;
    rdfs:label "报表"@zh ;
    rdfs:comment "M7 查询与报表"@zh .

tcm:Screen
    a owl:Class ;
    rdfs:label "界面"@zh ;
    rdfs:comment "MU 屏幕"@zh .

tcm:grantsPermission
    a owl:ObjectProperty ;
    rdfs:domain tcm:Role ;
    rdfs:range tcm:Permission ;
    rdfs:label "角色授予权限"@zh .

tcm:hasRole
    a owl:ObjectProperty ;
    rdfs:domain tcm:Actor ;
    rdfs:range tcm:Role ;
    rdfs:label "人员具有角色"@zh .

tcm:appliesRule
    a owl:ObjectProperty ;
    rdfs:domain tcm:Behavior ;
    rdfs:range tcm:Rule ;
    rdfs:label "行为适用规则"@zh .

tcm:hasActivity
    a owl:ObjectProperty ;
    rdfs:domain tcm:Flow ;
    rdfs:range tcm:FlowActivity ;
    rdfs:label "流程包含活动"@zh .

tcm:lifecycle
    a owl:AnnotationProperty ;
    rdfs:label "生命周期"@zh .

tcm:required
    a owl:AnnotationProperty ;
    rdfs:label "是否必填"@zh .

tcm:unique
    a owl:AnnotationProperty ;
    rdfs:label "是否唯一"@zh .

tcm:defaultValue
    a owl:AnnotationProperty ;
    rdfs:label "默认值"@zh .

tcm:dictionaryId
    a owl:AnnotationProperty ;
    rdfs:label "所属字典"@zh .

tcm:sortOrder
    a owl:AnnotationProperty ;
    rdfs:label "排序"@zh .

tcm:inverseLabel
    a owl:AnnotationProperty ;
    rdfs:label "反向角色名"@zh .

tcm:cardinality
    a owl:AnnotationProperty ;
    rdfs:label "基数"@zh .

tcm:referenceField
    a owl:AnnotationProperty ;
    rdfs:label "引用字段"@zh .

tcm:targetType
    a owl:AnnotationProperty ;
    rdfs:label "目标类型"@zh .

tcm:dataScope
    a owl:AnnotationProperty ;
    rdfs:label "数据范围"@zh .

tcm:actorType
    a owl:AnnotationProperty ;
    rdfs:label "主体类型"@zh .

tcm:behaviorType
    a owl:AnnotationProperty ;
    rdfs:label "行为类型"@zh .

tcm:triggerType
    a owl:AnnotationProperty ;
    rdfs:label "触发方式"@zh .

tcm:ownerEntity
    a owl:AnnotationProperty ;
    rdfs:label "所属实体ID"@zh .

tcm:ownerEntityName
    a owl:AnnotationProperty ;
    rdfs:label "所属实体"@zh .

tcm:precondition
    a owl:AnnotationProperty ;
    rdfs:label "前置条件"@zh .

tcm:postcondition
    a owl:AnnotationProperty ;
    rdfs:label "后置条件"@zh .

tcm:appliedRule
    a owl:AnnotationProperty ;
    rdfs:label "适用规则ID"@zh .

tcm:ruleType
    a owl:AnnotationProperty ;
    rdfs:label "规则类型"@zh .

tcm:outputType
    a owl:AnnotationProperty ;
    rdfs:label "输出类型"@zh .

tcm:expression
    a owl:AnnotationProperty ;
    rdfs:label "规则表达式"@zh .

tcm:inputParam
    a owl:AnnotationProperty ;
    rdfs:label "输入参数"@zh .

tcm:reusedByBehavior
    a owl:AnnotationProperty ;
    rdfs:label "被行为引用"@zh .

tcm:flowType
    a owl:AnnotationProperty ;
    rdfs:label "流程类型"@zh .

tcm:businessObject
    a owl:AnnotationProperty ;
    rdfs:label "涉及业务对象"@zh .

tcm:involvedRole
    a owl:AnnotationProperty ;
    rdfs:label "涉及角色"@zh .

tcm:startActivity
    a owl:AnnotationProperty ;
    rdfs:label "起始活动"@zh .

tcm:endActivity
    a owl:AnnotationProperty ;
    rdfs:label "结束活动"@zh .

tcm:performer
    a owl:AnnotationProperty ;
    rdfs:label "执行角色"@zh .

tcm:activityType
    a owl:AnnotationProperty ;
    rdfs:label "活动类型"@zh .

tcm:behaviorRef
    a owl:AnnotationProperty ;
    rdfs:label "对应行为"@zh .

tcm:sourceObject
    a owl:AnnotationProperty ;
    rdfs:label "来源对象"@zh .

tcm:resultColumn
    a owl:AnnotationProperty ;
    rdfs:label "结果列"@zh .

tcm:parameter
    a owl:AnnotationProperty ;
    rdfs:label "参数"@zh .

tcm:groupBy
    a owl:AnnotationProperty ;
    rdfs:label "分组字段"@zh .

tcm:screenType
    a owl:AnnotationProperty ;
    rdfs:label "屏幕类型"@zh .

tcm:elementCount
    a owl:AnnotationProperty ;
    rdfs:label "元素数"@zh .

tcm:actionCount
    a owl:AnnotationProperty ;
    rdfs:label "动作数"@zh .

tcm:Screen_frmPatientCreate
    a owl:NamedIndividual ;
    a tcm:Screen ;
    rdfs:label "患者建档"@zh ;
    skos:notation "frmPatientCreate" ;
    tcm:screenType "SINGLE_FORM" ;
    tcm:elementCount "15" ;
    tcm:actionCount "2" .

