tcm:Role_ROLE_01
    a owl:NamedIndividual ;
    a tcm:Role ;
    rdfs:label "导诊员"@zh ;
    skos:notation "ROLE-01" ;
    rdfs:comment "门诊前台，负责患者建档、挂号与随访登记"@zh .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_PATIENT_SAVE .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_PATIENT_STATUS .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_VISIT_REGISTER .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_VISIT_CANCEL .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_FOLLOWUP_COMPLETE .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_FOLLOWUP_LOST .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_QUERY_VISIT_PRESCRIPTION .

tcm:Role_ROLE_01
    tcm:grantsPermission tcm:Permission_PERM_QUERY_FOLLOWUP .

tcm:Role_ROLE_02
    a owl:NamedIndividual ;
    a tcm:Role ;
    rdfs:label "中医师"@zh ;
    skos:notation "ROLE-02" ;
    rdfs:comment "门诊医师，负责接诊、四诊录入、辨证、开具处方与随访"@zh .

tcm:Role_ROLE_02
    tcm:grantsPermission tcm:Permission_PERM_VISIT_RECEIVE .

tcm:Role_ROLE_02
    tcm:grantsPermission tcm:Permission_PERM_VISIT_FOURDIAGNOSIS .

tcm:Role_ROLE_02
    tcm:grantsPermission tcm:Permission_PERM_VISIT_CANCEL .

tcm:Role_ROLE_02
    tcm:grantsPermission tcm:Permission_PERM_DIAGNOSIS_SAVE .

tcm:Role_ROLE_02
    tcm:grantsPermission tcm:Permission_PERM_DIAGNOSIS_CONFIRM .

