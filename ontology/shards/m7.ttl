    tcm:resultColumn "{\"name\": \"deptCode\", \"label\": \"科室\", \"dataType\": \"DictionaryRef\", \"sourceExpression\": \"visit.deptCode\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}" ;
    tcm:resultColumn "{\"name\": \"visitStatus\", \"label\": \"就诊状态\", \"dataType\": \"Enum\", \"sourceExpression\": \"visit.visitStatus\", \"aggregateFunction\": \"NONE\", \"format\": null, \"nullable\": false, \"visible\": true, \"sortable\": true}" ;
