# 中医问诊系统 · SHACL 结构校验形状。由 tools/ontology_extras.py 从 M1 字段元数据机械生成。
# 校验的是「结构契约」：必填、单值、数据类型、引用目标类。业务逻辑不在此（权威口径见 M3 与引擎）。
# 注意：SHACL 无「全局唯一」表达，unique 字段用 sh:maxCount 1 近似（单值），实测见 ontology/README.md。

@prefix tcm:  <http://hermes.local/tcm-ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

tcm:PatientShape a sh:NodeShape ;
    rdfs:label "患者 结构校验"@zh ;
    sh:targetClass tcm:Patient ;
    skos:notation "AGG-PATIENT-001" ;
    sh:property [ sh:path tcm:Patient_patientNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "患者编号"@zh ] ;
    sh:property [ sh:path tcm:Patient_patientName ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "患者姓名"@zh ] ;
    sh:property [ sh:path tcm:Patient_gender ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_GENDER ;
                 rdfs:label "性别"@zh ] ;
    sh:property [ sh:path tcm:Patient_birthDate ;
                 sh:minCount 0 ;
                 sh:datatype xsd:date ;
                 rdfs:label "出生日期"@zh ] ;
    sh:property [ sh:path tcm:Patient_age ;
                 sh:minCount 0 ;
                 sh:datatype xsd:integer ;
                 rdfs:label "年龄"@zh ] ;
    sh:property [ sh:path tcm:Patient_idType ;
                 sh:minCount 0 ;
                 sh:class tcm:Enum_ID_TYPE ;
                 rdfs:label "证件类型"@zh ] ;
    sh:property [ sh:path tcm:Patient_idNo ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "证件号码"@zh ] ;
    sh:property [ sh:path tcm:Patient_phone ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "联系电话"@zh ] ;
    sh:property [ sh:path tcm:Patient_address ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "联系地址"@zh ] ;
    sh:property [ sh:path tcm:Patient_occupation ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "职业"@zh ] ;
    sh:property [ sh:path tcm:Patient_allergyHistory ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "过敏史"@zh ] ;
    sh:property [ sh:path tcm:Patient_patientStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_PATIENT_STATUS ;
                 rdfs:label "患者状态"@zh ] ;
    sh:property [ sh:path tcm:Patient_remark ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "备注"@zh ] .

tcm:VisitShape a sh:NodeShape ;
    rdfs:label "就诊记录 结构校验"@zh ;
    sh:targetClass tcm:Visit ;
    skos:notation "AGG-VISIT-001" ;
    sh:property [ sh:path tcm:Visit_visitNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "就诊号"@zh ] ;
    sh:property [ sh:path tcm:Visit_patientId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_PATIENT_001 ;
                 rdfs:label "患者"@zh ] ;
    sh:property [ sh:path tcm:Visit_visitType ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_VISIT_TYPE ;
                 rdfs:label "就诊类型"@zh ] ;
    sh:property [ sh:path tcm:Visit_previousVisitId ;
                 sh:minCount 0 ;
                 sh:class tcm:AGG_VISIT_001 ;
                 rdfs:label "上次就诊"@zh ] ;
    sh:property [ sh:path tcm:Visit_registerTime ;
                 sh:minCount 1 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "挂号时间"@zh ] ;
    sh:property [ sh:path tcm:Visit_receiveTime ;
                 sh:minCount 0 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "接诊时间"@zh ] ;
    sh:property [ sh:path tcm:Visit_doctorId ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "接诊医师"@zh ] ;
    sh:property [ sh:path tcm:Visit_deptCode ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_DEPT ;
                 rdfs:label "科室"@zh ] ;
    sh:property [ sh:path tcm:Visit_chiefComplaint ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "主诉"@zh ] ;
    sh:property [ sh:path tcm:Visit_presentIllness ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "现病史"@zh ] ;
    sh:property [ sh:path tcm:Visit_pastHistory ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "既往史"@zh ] ;
    sh:property [ sh:path tcm:Visit_vitalSigns ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "生命体征"@zh ] ;
    sh:property [ sh:path tcm:Visit_visitStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_VISIT_STATUS ;
                 rdfs:label "就诊状态"@zh ] ;
    sh:property [ sh:path tcm:Visit_remark ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "备注"@zh ] .

tcm:SyndromeDiagnosisShape a sh:NodeShape ;
    rdfs:label "辨证结论 结构校验"@zh ;
    sh:targetClass tcm:SyndromeDiagnosis ;
    skos:notation "AGG-DIAGNOSIS-001" ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_diagnosisNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "辨证号"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_visitId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_VISIT_001 ;
                 rdfs:label "就诊记录"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_diagnosisMethod ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_DIAG_METHOD ;
                 rdfs:label "辨证方法"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_syndromeId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_SYNDROME_001 ;
                 rdfs:label "证型"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_syndromeNature ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_SYNDROME_NATURE ;
                 rdfs:label "证型性质"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_diagnosisBasis ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "辨证依据"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_treatmentPrinciple ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "治法"@zh ] ;
    sh:property [ sh:path tcm:SyndromeDiagnosis_conclusionStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_CONCLUSION_STATUS ;
                 rdfs:label "结论状态"@zh ] .

tcm:SyndromeTypeShape a sh:NodeShape ;
    rdfs:label "证型字典 结构校验"@zh ;
    sh:targetClass tcm:SyndromeType ;
    skos:notation "AGG-SYNDROME-001" ;
    sh:property [ sh:path tcm:SyndromeType_syndromeCode ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "证型编码"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_syndromeName ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "证型名称"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_diagnosisMethod ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_DIAG_METHOD ;
                 rdfs:label "所属辨证体系"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_syndromeDescription ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "证候描述"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_commonSymptoms ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "常见症状"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_correspondingTreatment ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "对应治法"@zh ] ;
    sh:property [ sh:path tcm:SyndromeType_syndromeStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_USE_STATUS ;
                 rdfs:label "状态"@zh ] .

tcm:FormulaTemplateShape a sh:NodeShape ;
    rdfs:label "方剂模板 结构校验"@zh ;
    sh:targetClass tcm:FormulaTemplate ;
    skos:notation "AGG-FORMULA-001" ;
    sh:property [ sh:path tcm:FormulaTemplate_formulaCode ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "方剂编码"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_formulaName ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "方剂名称"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_formulaType ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_FORMULA_TYPE ;
                 rdfs:label "方剂类型"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_source ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "出处"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_function ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "功用"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_indication ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "主治"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_defaultDoses ;
                 sh:minCount 0 ;
                 sh:datatype xsd:integer ;
                 rdfs:label "常用剂数"@zh ] ;
    sh:property [ sh:path tcm:FormulaTemplate_formulaStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_USE_STATUS ;
                 rdfs:label "状态"@zh ] .

tcm:HerbShape a sh:NodeShape ;
    rdfs:label "中药饮片 结构校验"@zh ;
    sh:targetClass tcm:Herb ;
    skos:notation "AGG-HERB-001" ;
    sh:property [ sh:path tcm:Herb_herbCode ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "饮片编码"@zh ] ;
    sh:property [ sh:path tcm:Herb_herbName ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "饮片名称"@zh ] ;
    sh:property [ sh:path tcm:Herb_aliasName ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "别名"@zh ] ;
    sh:property [ sh:path tcm:Herb_herbCategory ;
                 sh:minCount 0 ;
                 sh:class tcm:Enum_HERB_CATEGORY ;
                 rdfs:label "药材类别"@zh ] ;
    sh:property [ sh:path tcm:Herb_natureMeridian ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "性味归经"@zh ] ;
    sh:property [ sh:path tcm:Herb_efficacy ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "功效"@zh ] ;
    sh:property [ sh:path tcm:Herb_minCommonDose ;
                 sh:minCount 1 ;
                 sh:datatype xsd:decimal ;
                 rdfs:label "常用最小量"@zh ] ;
    sh:property [ sh:path tcm:Herb_maxCommonDose ;
                 sh:minCount 1 ;
                 sh:datatype xsd:decimal ;
                 rdfs:label "常用最大量"@zh ] ;
    sh:property [ sh:path tcm:Herb_toxicityLevel ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_TOXICITY_LEVEL ;
                 rdfs:label "毒性分级"@zh ] ;
    sh:property [ sh:path tcm:Herb_toxicDoseLimit ;
                 sh:minCount 0 ;
                 sh:datatype xsd:decimal ;
                 rdfs:label "毒性单张处方总量上限"@zh ] ;
    sh:property [ sh:path tcm:Herb_specialManaged ;
                 sh:minCount 1 ;
                 sh:datatype xsd:boolean ;
                 rdfs:label "是否特殊管理"@zh ] ;
    sh:property [ sh:path tcm:Herb_stockQuantity ;
                 sh:minCount 1 ;
                 sh:datatype xsd:decimal ;
                 rdfs:label "库存数量"@zh ] ;
    sh:property [ sh:path tcm:Herb_lowStockThreshold ;
                 sh:minCount 0 ;
                 sh:datatype xsd:decimal ;
                 rdfs:label "低库存预警值"@zh ] ;
    sh:property [ sh:path tcm:Herb_origin ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "产地"@zh ] ;
    sh:property [ sh:path tcm:Herb_spec ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "规格"@zh ] ;
    sh:property [ sh:path tcm:Herb_herbStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_USE_STATUS ;
                 rdfs:label "状态"@zh ] .

tcm:PrescriptionShape a sh:NodeShape ;
    rdfs:label "处方 结构校验"@zh ;
    sh:targetClass tcm:Prescription ;
    skos:notation "AGG-PRESCRIPTION-001" ;
    sh:property [ sh:path tcm:Prescription_prescriptionNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "处方号"@zh ] ;
    sh:property [ sh:path tcm:Prescription_visitId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_VISIT_001 ;
                 rdfs:label "就诊记录"@zh ] ;
    sh:property [ sh:path tcm:Prescription_patientId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_PATIENT_001 ;
                 rdfs:label "患者"@zh ] ;
    sh:property [ sh:path tcm:Prescription_doctorId ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "开方医师"@zh ] ;
    sh:property [ sh:path tcm:Prescription_prescriptionType ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_PRESCRIPTION_TYPE ;
                 rdfs:label "处方类型"@zh ] ;
    sh:property [ sh:path tcm:Prescription_formulaTemplateId ;
                 sh:minCount 0 ;
                 sh:class tcm:AGG_FORMULA_001 ;
                 rdfs:label "引用方剂模板"@zh ] ;
    sh:property [ sh:path tcm:Prescription_doses ;
                 sh:minCount 1 ;
                 sh:datatype xsd:integer ;
                 rdfs:label "剂数"@zh ] ;
    sh:property [ sh:path tcm:Prescription_usageMethod ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_USAGE_METHOD ;
                 rdfs:label "用法"@zh ] ;
    sh:property [ sh:path tcm:Prescription_decoctionInstruction ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "煎服说明"@zh ] ;
    sh:property [ sh:path tcm:Prescription_medicalAdvice ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "医嘱嘱托"@zh ] ;
    sh:property [ sh:path tcm:Prescription_prescribeTime ;
                 sh:minCount 1 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "开方时间"@zh ] ;
    sh:property [ sh:path tcm:Prescription_submitTime ;
                 sh:minCount 0 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "提交时间"@zh ] ;
    sh:property [ sh:path tcm:Prescription_prescriptionStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_PRESCRIPTION_STATUS ;
                 rdfs:label "处方状态"@zh ] ;
    sh:property [ sh:path tcm:Prescription_reviewerId ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "审核人"@zh ] ;
    sh:property [ sh:path tcm:Prescription_reviewTime ;
                 sh:minCount 0 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "审核时间"@zh ] ;
    sh:property [ sh:path tcm:Prescription_rejectReason ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "驳回原因"@zh ] ;
    sh:property [ sh:path tcm:Prescription_cancelReason ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "作废原因"@zh ] .

tcm:DispenseRecordShape a sh:NodeShape ;
    rdfs:label "调剂发药记录 结构校验"@zh ;
    sh:targetClass tcm:DispenseRecord ;
    skos:notation "AGG-DISPENSE-001" ;
    sh:property [ sh:path tcm:DispenseRecord_dispenseNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "发药单号"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_prescriptionId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_PRESCRIPTION_001 ;
                 rdfs:label "处方"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_dispenserId ;
                 sh:minCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "调剂人"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_checkerId ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "复核人"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_dispenseTime ;
                 sh:minCount 1 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "调剂时间"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_issueTime ;
                 sh:minCount 0 ;
                 sh:datatype xsd:dateTime ;
                 rdfs:label "发药时间"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_recordStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_DISPENSE_STATUS ;
                 rdfs:label "记录状态"@zh ] ;
    sh:property [ sh:path tcm:DispenseRecord_remark ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "备注"@zh ] .

tcm:FollowUpShape a sh:NodeShape ;
    rdfs:label "复诊随访记录 结构校验"@zh ;
    sh:targetClass tcm:FollowUp ;
    skos:notation "AGG-FOLLOWUP-001" ;
    sh:property [ sh:path tcm:FollowUp_followUpNo ;
                 sh:minCount 1 ;
                 sh:maxCount 1 ;
                 sh:datatype xsd:string ;
                 rdfs:label "随访号"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_patientId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_PATIENT_001 ;
                 rdfs:label "患者"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_sourceVisitId ;
                 sh:minCount 1 ;
                 sh:class tcm:AGG_VISIT_001 ;
                 rdfs:label "上次就诊"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_actualVisitId ;
                 sh:minCount 0 ;
                 sh:class tcm:AGG_VISIT_001 ;
                 rdfs:label "本次就诊"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_plannedFollowUpDate ;
                 sh:minCount 1 ;
                 sh:datatype xsd:date ;
                 rdfs:label "计划随访日期"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_actualFollowUpDate ;
                 sh:minCount 0 ;
                 sh:datatype xsd:date ;
                 rdfs:label "实际随访日期"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_efficacyLevel ;
                 sh:minCount 0 ;
                 sh:class tcm:Enum_EFFICACY_LEVEL ;
                 rdfs:label "疗效评价"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_symptomChange ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "症状变化"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_continueMedication ;
                 sh:minCount 0 ;
                 sh:datatype xsd:boolean ;
                 rdfs:label "是否继续用药"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_recordStatus ;
                 sh:minCount 1 ;
                 sh:class tcm:Enum_FOLLOWUP_STATUS ;
                 rdfs:label "记录状态"@zh ] ;
    sh:property [ sh:path tcm:FollowUp_remark ;
                 sh:minCount 0 ;
                 sh:datatype xsd:string ;
                 rdfs:label "备注"@zh ] .
