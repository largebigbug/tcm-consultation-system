    rdfs:label "创建待调剂记录"@zh ;
    skos:notation "Q05" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-05；审核通过后生成状态为「待调剂」的调剂发药记录（药剂师调剂入口）"@zh .

tcm:Flow_FLOW_PRESCRIPTION_APPROVAL_001
    tcm:hasActivity tcm:Activity_FLOW_PRESCRIPTION_APPROVAL_001_Q05 .

