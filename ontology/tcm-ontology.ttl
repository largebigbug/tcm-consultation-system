@prefix tcm:  <http://hermes.local/tcm-ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

tcm:ontology
    a owl:Ontology ;
    rdfs:label "中医问诊系统本体"@zh ;
    rdfs:comment "由 7 个本体模型（M1/M2/M3/M5/M6/M7/MU）机械生成；领域：中医问诊"@zh ;
    dcterms:source "中医问诊系统-需求规格说明书-V9" ;
    owl:versionInfo "2.1" .

tcm:Aggregate
    a owl:Class ;
    rdfs:label "聚合根"@zh ;
    rdfs:comment "可独立存在的业务对象（M1 聚合根）"@zh .

tcm:Enumeration
    a owl:Class ;
    rdfs:label "枚举字典"@zh ;
    rdfs:comment "M1 数据字典中的取值类型"@zh .

tcm:Role
    a owl:Class ;
    rdfs:label "角色"@zh ;
    rdfs:comment "M5 角色（权限集合）"@zh .

tcm:Actor
    a owl:Class ;
    rdfs:label "人员/主体"@zh ;
    rdfs:comment "M5 参与者（人）"@zh .

tcm:Behavior
    a owl:Class ;
    rdfs:label "行为"@zh ;
    rdfs:comment "M2 行为（命令/查询等）"@zh .

tcm:Permission
    a owl:Class ;
    rdfs:label "权限"@zh ;
    rdfs:comment "M5 权限项（行为级 + 数据范围）"@zh .

tcm:Rule
    a owl:Class ;
    rdfs:label "业务规则"@zh ;
    rdfs:comment "M3 规则（校验/计算/分派）"@zh .

tcm:Flow
    a owl:Class ;
    rdfs:label "流程"@zh ;
    rdfs:comment "M6 流程定义"@zh .

tcm:FlowActivity
    a owl:Class ;
    rdfs:label "流程活动"@zh ;
    rdfs:comment "M6 流程内的活动节点"@zh .

tcm:Report
    a owl:Class ;
    rdfs:label "报表"@zh ;
    rdfs:comment "M7 查询与报表"@zh .

tcm:Screen
    a owl:Class ;
    rdfs:label "界面"@zh ;
    rdfs:comment "MU 屏幕"@zh .


# ---------- 自定义对象属性（个体/类之间的连接）----------
tcm:grantsPermission
    a owl:ObjectProperty ;
    rdfs:domain tcm:Role ;
    rdfs:range tcm:Permission ;
    rdfs:label "角色授予权限"@zh .

tcm:hasRole
    a owl:ObjectProperty ;
    rdfs:domain tcm:Actor ;
    rdfs:range tcm:Role ;
    rdfs:label "人员具有角色"@zh .

tcm:appliesRule
    a owl:ObjectProperty ;
    rdfs:domain tcm:Behavior ;
    rdfs:range tcm:Rule ;
    rdfs:label "行为适用规则"@zh .

tcm:hasActivity
    a owl:ObjectProperty ;
    rdfs:domain tcm:Flow ;
    rdfs:range tcm:FlowActivity ;
    rdfs:label "流程包含活动"@zh .


