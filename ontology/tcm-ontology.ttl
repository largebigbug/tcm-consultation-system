tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A10 .

tcm:Activity_FLOW_VISIT_001_A11
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "中药处方审核"@zh ;
    skos:notation "A11" ;
    tcm:activityType "SUB_FLOW_CALL" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A11 .

tcm:Activity_FLOW_VISIT_001_G03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "处方审核结果判定"@zh ;
    skos:notation "G03" ;
    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G03 .

tcm:Activity_FLOW_VISIT_001_A12
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "创建待调剂记录"@zh ;
    skos:notation "A12" ;
    tcm:activityType "SYSTEM_TASK" ;
    rdfs:comment "B-05；审核通过后生成待调剂记录（药剂师调剂入口）"@zh .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A12 .

tcm:Activity_FLOW_VISIT_001_A13
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "确认调剂（按明细配齐饮片）"@zh ;
    skos:notation "A13" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-03" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A13 .

tcm:Activity_FLOW_VISIT_001_G04
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "饮片库存充足性判定"@zh ;
