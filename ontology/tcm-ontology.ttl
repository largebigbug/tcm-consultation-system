tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A16 .

tcm:Activity_FLOW_VISIT_001_A17
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
