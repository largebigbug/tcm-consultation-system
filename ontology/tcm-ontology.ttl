# ---------- M2 行为 ----------
tcm:Behavior_Patient_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "患者建档与修改"@zh ;
    skos:notation "Patient_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PATIENT-001" ;
    tcm:ownerEntityName "患者"@zh ;
    rdfs:comment "对应 FUNC-01；新增患者档案或修改既有档案基本信息"@zh ;
    tcm:precondition "患者姓名为必填且长度 2～20 字"@zh ;
    tcm:precondition "出生日期与年龄至少填写一项"@zh ;
    tcm:precondition "同一「证件类型 + 证件号码」不存在重复建档（INV-01）"@zh ;
    tcm:postcondition "{\"field\": \"patient.patientStatus\", \"setValue\": \"在用（新增时按默认值写入）\"}" ;
    tcm:postcondition "{\"field\": \"patient.age\", \"setValue\": \"有出生日期时按出生日期自动计算\"}" .

tcm:Behavior_Patient_ChangeStatus
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "患者停用与启用"@zh ;
    skos:notation "Patient_ChangeStatus" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PATIENT-001" ;
    tcm:ownerEntityName "患者"@zh ;
    rdfs:comment "对应 FUNC-01（停用并入建档功能，D-23）；不物理删除患者档案"@zh ;
    tcm:precondition "停用时该患者不存在「已挂号」或「接诊中」的就诊记录"@zh ;
    tcm:precondition "patient.patientStatus == '在用'（停用）或 '停用'（启用）"@zh ;
    tcm:postcondition "{\"field\": \"patient.patientStatus\", \"setValue\": \"停用 或 在用\"}" .

tcm:Behavior_Visit_Register
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "门诊挂号"@zh ;
    skos:notation "Visit_Register" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 FUNC-02；为患者在门诊挂号并建立就诊记录"@zh ;
    tcm:precondition "patient.patientStatus == '在用'"@zh ;
    tcm:precondition "就诊类型为复诊时必须选定上次就诊记录"@zh ;
    tcm:postcondition "{\"field\": \"visit.visitStatus\", \"setValue\": \"已挂号\"}" ;
    tcm:postcondition "{\"field\": \"visit.registerTime\", \"setValue\": \"NOW()\"}" .

tcm:Behavior_Visit_Receive
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "接诊开单"@zh ;
    skos:notation "Visit_Receive" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 FUNC-03；医师开始接诊，记录接诊时间与接诊医师"@zh ;
    tcm:precondition "visit.visitStatus == '已挂号'"@zh ;
    tcm:precondition "主诉已填写，长度不超过 200 字（该环节负责录入主诉）"@zh ;
    tcm:postcondition "{\"field\": \"visit.visitStatus\", \"setValue\": \"接诊中\"}" ;
    tcm:postcondition "{\"field\": \"visit.receiveTime\", \"setValue\": \"NOW()\"}" ;
    tcm:postcondition "{\"field\": \"visit.doctorId\", \"setValue\": \"当前登录用户\"}" .

tcm:Behavior_Visit_SaveFourDiagnosis
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "录入四诊信息"@zh ;
    skos:notation "Visit_SaveFourDiagnosis" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 FUNC-04；录入或修改本次就诊的望闻问切结构化记录（聚合内子实体，同事务）"@zh ;
    tcm:precondition "visit.visitStatus == '接诊中'"@zh ;
    tcm:precondition "脉象为必填项"@zh ;
    tcm:postcondition "{\"field\": \"visit.FourDiagnosis.pulseCode\", \"setValue\": \"按录入值保存\"}" ;
    tcm:postcondition "{\"field\": \"visit.FourDiagnosis\", \"setValue\": \"新增或更新本次就诊唯一一份四诊信息\"}" .

tcm:Behavior_Visit_Cancel
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "撤销就诊"@zh ;
    skos:notation "Visit_Cancel" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 FUNC-16；患者未就诊或误挂号时撤销就诊，不物理删除"@zh ;
    tcm:precondition "visit.visitStatus IN ['已挂号', '接诊中']"@zh ;
    tcm:precondition "该就诊下不存在任何处方"@zh ;
    tcm:precondition "撤销原因已填写（记入备注）"@zh ;
    tcm:postcondition "{\"field\": \"visit.visitStatus\", \"setValue\": \"已取消\"}" ;
    tcm:postcondition "{\"field\": \"visit.remark\", \"setValue\": \"追加撤销原因\"}" .

tcm:Behavior_Diagnosis_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "保存辨证结论草稿"@zh ;
    skos:notation "Diagnosis_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-DIAGNOSIS-001" ;
    tcm:ownerEntityName "辨证结论"@zh ;
    rdfs:comment "对应 FUNC-05；保存辨证结论草稿，可反复修改"@zh ;
    tcm:precondition "所属就诊存在四诊信息"@zh ;
    tcm:precondition "证型、辨证方法、证型性质已选择"@zh ;
    tcm:precondition "辨证依据不少于 10 字"@zh ;
    tcm:postcondition "{\"field\": \"syndromeDiagnosis.conclusionStatus\", \"setValue\": \"草稿\"}" .

tcm:Behavior_Diagnosis_Confirm
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "确认辨证结论"@zh ;
    skos:notation "Diagnosis_Confirm" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-DIAGNOSIS-001" ;
    tcm:ownerEntityName "辨证结论"@zh ;
    rdfs:comment "对应 FUNC-05；结论定稿，之后可据此开方"@zh ;
    tcm:precondition "所属就诊未完成（visit.visitStatus == '接诊中'）"@zh ;
    tcm:precondition "主证性质结论在同一就诊下唯一（INV-02）"@zh ;
    tcm:precondition "治法已填写"@zh ;
    tcm:postcondition "{\"field\": \"syndromeDiagnosis.conclusionStatus\", \"setValue\": \"已确认\"}" .

tcm:Behavior_Syndrome_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "证型字典新增与修改"@zh ;
    skos:notation "Syndrome_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-SYNDROME-001" ;
    tcm:ownerEntityName "证型字典"@zh ;
    rdfs:comment "对应 FUNC-15；维护证型标准化定义"@zh ;
    tcm:precondition "证型编码符合 Z + 三位流水号规则"@zh ;
    tcm:precondition "证型名称唯一"@zh ;
    tcm:precondition "所属辨证体系已选择"@zh ;
    tcm:postcondition "{\"field\": \"syndromeType.syndromeCode\", \"setValue\": \"按规则生成或保存\"}" .

tcm:Behavior_Syndrome_ChangeStatus
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "证型字典停用与启用"@zh ;
    skos:notation "Syndrome_ChangeStatus" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-SYNDROME-001" ;
    tcm:ownerEntityName "证型字典"@zh ;
    rdfs:comment "对应 FUNC-15；被引用后不可删除，只能停用"@zh ;
    tcm:precondition "syndromeType.syndromeStatus == '启用'（停用）或 '停用'（启用）"@zh ;
    tcm:postcondition "{\"field\": \"syndromeType.syndromeStatus\", \"setValue\": \"停用 或 启用\"}" .

tcm:Behavior_Formula_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "方剂模板新增与修改"@zh ;
    skos:notation "Formula_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-FORMULA-001" ;
    tcm:ownerEntityName "方剂模板"@zh ;
    rdfs:comment "对应 FUNC-14；维护方剂模板及其组成明细（聚合内子实体，同事务）"@zh ;
    tcm:precondition "方剂编码符合 F + 三位流水号规则"@zh ;
    tcm:precondition "方剂名称唯一"@zh ;
    tcm:precondition "组成明细至少一味药味，且药味不重复"@zh ;
    tcm:postcondition "{\"field\": \"formulaTemplate.formulaCode\", \"setValue\": \"按规则生成或保存\"}" ;
    tcm:postcondition "{\"field\": \"formulaTemplate.FormulaItem\", \"setValue\": \"全量覆盖保存组成明细\"}" .

tcm:Behavior_Formula_ChangeStatus
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "方剂模板停用与启用"@zh ;
    skos:notation "Formula_ChangeStatus" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-FORMULA-001" ;
    tcm:ownerEntityName "方剂模板"@zh ;
    rdfs:comment "对应 FUNC-14；被处方引用后不可删除，只能停用"@zh ;
    tcm:precondition "formulaTemplate.formulaStatus == '启用'（停用）或 '停用'（启用）"@zh ;
    tcm:postcondition "{\"field\": \"formulaTemplate.formulaStatus\", \"setValue\": \"停用 或 启用\"}" .

tcm:Behavior_Herb_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片建档与修改"@zh ;
    skos:notation "Herb_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 FUNC-11；建立或修改饮片品目基础信息（常用量区间、毒性分级、预警值等）"@zh ;
    tcm:precondition "饮片编码符合 Y + 四位流水号规则"@zh ;
    tcm:precondition "饮片名称唯一"@zh ;
    tcm:precondition "常用最小量 > 0 且常用最大量 ≥ 常用最小量"@zh ;
    tcm:precondition "毒性分级已选择"@zh ;
    tcm:postcondition "{\"field\": \"herb.herbCode\", \"setValue\": \"按规则生成或保存\"}" ;
    tcm:postcondition "{\"field\": \"herb.stockQuantity\", \"setValue\": \"新增时为 0，不由本行为直接修改\"}" .

tcm:Behavior_Herb_Inbound
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片入库登记"@zh ;
    skos:notation "Herb_Inbound" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 FUNC-11；登记合格入库数量与入库单号（饮片验收留线下，D-27），\n同时追加「入库」流水并增加库存，二者属同一聚合、同一事务"@zh ;
    tcm:precondition "入伙数量大于 0"@zh ;
    tcm:precondition "herb.herbStatus == '启用'"@zh ;
    tcm:precondition "入库单号已填写"@zh ;
    tcm:postcondition "{\"field\": \"herb.stockQuantity\", \"setValue\": \"stockQuantity + 入库数量\"}" ;
    tcm:postcondition "{\"field\": \"herb.HerbStockFlow\", \"setValue\": \"追加一条业务类型为「入库」的流水（数量为正）\"}" .

tcm:Behavior_Herb_ChangeStatus
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片停用与启用"@zh ;
    skos:notation "Herb_ChangeStatus" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 FUNC-11（停用并入建档入库功能，D-31）；产生过流水或被处方引用后不可删除"@zh ;
    tcm:precondition "herb.herbStatus == '启用'（停用）或 '停用'（启用）"@zh ;
    tcm:postcondition "{\"field\": \"herb.herbStatus\", \"setValue\": \"停用 或 启用\"}" .

tcm:Behavior_Herb_Stocktake
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片库存盘点调整"@zh ;
    skos:notation "Herb_Stocktake" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 FUNC-12；按实盘结果登记盘点调整或报损（追加流水并修正库存），\n盘点前调用 R-06 输出账实差异供人工确认；低库存预警只做查询呈现，不推送（D-22）"@zh ;
    tcm:precondition "盘点调整原因或报损原因已填写"@zh ;
    tcm:precondition "调整数量不得为 0（REF-13）"@zh ;
    tcm:precondition "调整后库存数量不得为负（REF-08）"@zh ;
    tcm:postcondition "{\"field\": \"herb.stockQuantity\", \"setValue\": \"stockQuantity + 调整数量\"}" ;
    tcm:postcondition "{\"field\": \"herb.HerbStockFlow\", \"setValue\": \"追加一条业务类型为「盘点调整」或「报损」的流水\"}" ;
    tcm:appliedRule "RULE-HERB-STOCK-RECONCILE" .

tcm:Behavior_Prescription_Save
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "开具处方与保存草稿"@zh ;
    skos:notation "Prescription_Save" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应 FUNC-06；开具或修改处方主表与明细（聚合内同事务）。\n超量处理结论由 R-01 判定：NEED_REASON 时超量理由必填，BLOCK 时不允许保存"@zh ;
    tcm:precondition "visit.visitStatus == '接诊中'；或处方状态为「已驳回」时允许修改后重新提交（M6 Q04 驳回重提闭环，此时就诊已随提交收尾为「已完成」）"@zh ;
    tcm:precondition "所属就诊存在「已确认」的辨证结论"@zh ;
    tcm:precondition "剂数在 1 到 30 之间（REF-10）"@zh ;
    tcm:precondition "同一处方内饮片不重复，单剂剂量大于 0（REF-12）"@zh ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"草稿\"}" ;
    tcm:postcondition "{\"field\": \"prescription.prescribeTime\", \"setValue\": \"NOW()（首次保存时）\"}" ;
    tcm:postcondition "{\"field\": \"prescription.PrescriptionItem\", \"setValue\": \"全量覆盖保存处方明细（含超量理由）\"}" ;
    tcm:appliedRule "RULE-PRESCRIPTION-DOSE-LIMIT-CHECK" .

tcm:Behavior_Prescription_Submit
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "提交处方送审"@zh ;
    skos:notation "Prescription_Submit" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应 FUNC-07；处方明细非空（INV-04）后提交进入药师审核队列，\n并同步触发就诊状态收尾（B-04）。超常用量上限 2 倍或超毒性上限由规则阻断"@zh ;
    tcm:precondition "prescription.prescriptionStatus IN ['草稿', '已驳回']"@zh ;
    tcm:precondition "处方明细至少一味饮片（INV-04）"@zh ;
    tcm:precondition "超量药味已填写超量理由"@zh ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"待审核\"}" ;
    tcm:postcondition "{\"field\": \"prescription.submitTime\", \"setValue\": \"NOW()\"}" ;
    tcm:appliedRule "RULE-PRESCRIPTION-DOSE-LIMIT-CHECK" ;
    tcm:appliedRule "RULE-HERB-TOXIC-TOTAL-LIMIT-CHECK" .

tcm:Behavior_Prescription_Cancel
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "处方退回与作废"@zh ;
    skos:notation "Prescription_Cancel" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应 FUNC-09；作废按 R-04 三分派执行——无调剂记录或「待调剂」记录时仅作废并取消待调剂记录；\n「已调剂」时作废并回冲库存；「已发药」时阻断作废（退药走线下）。不物理删除处方"@zh ;
    tcm:precondition "prescription.prescriptionStatus IN ['草稿', '待审核', '审核通过', '已调剂']"@zh ;
    tcm:precondition "R-04 判定结果不为 BLOCK（已发药/已作废不可作废）"@zh ;
    tcm:precondition "作废原因已填写"@zh ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"已作废\"}" ;
    tcm:postcondition "{\"field\": \"prescription.cancelReason\", \"setValue\": \"写入作废原因\"}" ;
    tcm:appliedRule "RULE-PRESCRIPTION-VOID-DISPATCH" .

tcm:Behavior_Prescription_Review
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "处方审核"@zh ;
    skos:notation "Prescription_Review" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应审批行为 B-APP-01；中药师单节点审核（D-24：不做会签与条件加签，复核人选填）。\n审核通过置「审核通过」并进入调剂；驳回须填驳回原因并置「已驳回」，医师修改后可重新提交"@zh ;
    tcm:precondition "prescription.prescriptionStatus == '待审核'"@zh ;
    tcm:precondition "驳回时驳回原因已填写"@zh ;
    tcm:precondition "当前用户具备中药师角色（ROLE-03）"@zh ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"审核通过 或 已驳回\"}" ;
    tcm:postcondition "{\"field\": \"prescription.reviewerId\", \"setValue\": \"当前登录用户\"}" ;
    tcm:postcondition "{\"field\": \"prescription.reviewTime\", \"setValue\": \"NOW()\"}" .

tcm:Behavior_Dispense_Confirm
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "确认调剂"@zh ;
    skos:notation "Dispense_Confirm" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-DISPENSE-001" ;
    tcm:ownerEntityName "调剂发药记录"@zh ;
    rdfs:comment "对应 FUNC-10；确认调剂并同步扣减饮片库存（D-14）。库存不足由 R-02 阻断，\n不允许先调剂后补库"@zh ;
    tcm:precondition "dispenseRecord.recordStatus == '待调剂'"@zh ;
    tcm:precondition "对应处方状态为「审核通过」"@zh ;
    tcm:precondition "R-02 判定全部饮片库存充足"@zh ;
    tcm:postcondition "{\"field\": \"dispenseRecord.recordStatus\", \"setValue\": \"已调剂\"}" ;
    tcm:postcondition "{\"field\": \"dispenseRecord.dispenseTime\", \"setValue\": \"NOW()\"}" ;
    tcm:postcondition "{\"field\": \"dispenseRecord.dispenserId\", \"setValue\": \"当前登录用户\"}" ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"已调剂\"}" ;
    tcm:appliedRule "RULE-HERB-STOCK-SUFFICIENT" .

tcm:Behavior_Dispense_Issue
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "发药确认"@zh ;
    skos:notation "Dispense_Issue" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-DISPENSE-001" ;
    tcm:ownerEntityName "调剂发药记录"@zh ;
    rdfs:comment "对应 FUNC-10；确认发药，处方业务闭环（库存已在确认调剂时扣减）"@zh ;
    tcm:precondition "dispenseRecord.recordStatus == '已调剂'"@zh ;
    tcm:postcondition "{\"field\": \"dispenseRecord.recordStatus\", \"setValue\": \"已发药\"}" ;
    tcm:postcondition "{\"field\": \"dispenseRecord.issueTime\", \"setValue\": \"NOW()\"}" ;
    tcm:postcondition "{\"field\": \"prescription.prescriptionStatus\", \"setValue\": \"已发药\"}" .

tcm:Behavior_FollowUp_Complete
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "复诊登记与疗效评价"@zh ;
    skos:notation "FollowUp_Complete" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-FOLLOWUP-001" ;
    tcm:ownerEntityName "复诊随访记录"@zh ;
    rdfs:comment "对应 FUNC-13；患者实际复诊时回填本次就诊并记录疗效评价"@zh ;
    tcm:precondition "followUp.recordStatus == '待随访'"@zh ;
    tcm:precondition "实际随访日期不早于上次就诊挂号时间（R-05）"@zh ;
    tcm:precondition "本次就诊记录已选定"@zh ;
    tcm:postcondition "{\"field\": \"followUp.recordStatus\", \"setValue\": \"已完成\"}" ;
    tcm:postcondition "{\"field\": \"followUp.actualVisitId\", \"setValue\": \"本次就诊记录\"}" ;
    tcm:postcondition "{\"field\": \"followUp.actualFollowUpDate\", \"setValue\": \"按填入值保存\"}" ;
    tcm:postcondition "{\"field\": \"followUp.efficacyLevel\", \"setValue\": \"按评价结果保存\"}" ;
    tcm:appliedRule "RULE-FOLLOWUP-DATE-ORDER" .

tcm:Behavior_FollowUp_MarkLost
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "标记失访"@zh ;
    skos:notation "FollowUp_MarkLost" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-FOLLOWUP-001" ;
    tcm:ownerEntityName "复诊随访记录"@zh ;
    rdfs:comment "对应 FUNC-13；计划随访日期超期且患者未复诊时标记失访，不物理删除"@zh ;
    tcm:precondition "followUp.recordStatus == '待随访'"@zh ;
    tcm:precondition "计划随访日期已超期"@zh ;
    tcm:precondition "失访原因已填写"@zh ;
    tcm:postcondition "{\"field\": \"followUp.recordStatus\", \"setValue\": \"已失访\"}" ;
    tcm:postcondition "{\"field\": \"followUp.remark\", \"setValue\": \"追加失访原因\"}" .

tcm:Behavior_Visit_QueryStats
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询门诊量统计"@zh ;
    skos:notation "Visit_QueryStats" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 Q-01"@zh .

tcm:Behavior_Diagnosis_QuerySyndromeDistribution
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询证型分布统计"@zh ;
    skos:notation "Diagnosis_QuerySyndromeDistribution" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-DIAGNOSIS-001" ;
    tcm:ownerEntityName "辨证结论"@zh ;
    rdfs:comment "对应 Q-02"@zh .

tcm:Behavior_Prescription_QueryHerbUsage
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询方剂与饮片使用统计"@zh ;
    skos:notation "Prescription_QueryHerbUsage" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应 Q-03"@zh .

tcm:Behavior_Visit_QueryVisitAndPrescription
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询就诊与处方记录"@zh ;
    skos:notation "Visit_QueryVisitAndPrescription" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 Q-04"@zh .

tcm:Behavior_Herb_QueryStockAndAlert
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询饮片库存与预警"@zh ;
    skos:notation "Herb_QueryStockAndAlert" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 Q-05"@zh .

tcm:Behavior_Prescription_QueryOverdoseReview
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询超量毒性处方审核台账"@zh ;
    skos:notation "Prescription_QueryOverdoseReview" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-PRESCRIPTION-001" ;
    tcm:ownerEntityName "处方"@zh ;
    rdfs:comment "对应 Q-06"@zh .

tcm:Behavior_FollowUp_QueryCompletion
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "查询随访完成与失访分析"@zh ;
    skos:notation "FollowUp_QueryCompletion" ;
    tcm:behaviorType "QUERY" ;
    tcm:triggerType "USER_ACTION" ;
    tcm:ownerEntity "AGG-FOLLOWUP-001" ;
    tcm:ownerEntityName "复诊随访记录"@zh ;
    rdfs:comment "对应 Q-07"@zh .

tcm:Behavior_Visit_Complete
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "就诊状态收尾"@zh ;
    skos:notation "Visit_Complete" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-VISIT-001" ;
    tcm:ownerEntityName "就诊记录"@zh ;
    rdfs:comment "对应 B-04；处方提交送审成功后由 Prescription_Submit 同步触发，就诊置「已完成」"@zh ;
    tcm:precondition "visit.visitStatus == '接诊中'"@zh ;
    tcm:precondition "存在已提交成功的处方"@zh ;
    tcm:postcondition "{\"field\": \"visit.visitStatus\", \"setValue\": \"已完成\"}" .

tcm:Behavior_FollowUp_CreatePlan
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "复诊提醒生成"@zh ;
    skos:notation "FollowUp_CreatePlan" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-FOLLOWUP-001" ;
    tcm:ownerEntityName "复诊随访记录"@zh ;
    rdfs:comment "对应 B-03；就诊完成后生成待随访记录，计划随访日期 = 就诊日 + 剂数 × 1 天（D-17）"@zh ;
    tcm:precondition "就诊状态为「已完成」"@zh ;
    tcm:precondition "该次就诊存在提交成功的处方"@zh ;
    tcm:postcondition "{\"field\": \"followUp.followUpNo\", \"setValue\": \"系统生成\"}" ;
    tcm:postcondition "{\"field\": \"followUp.recordStatus\", \"setValue\": \"待随访\"}" ;
    tcm:postcondition "{\"field\": \"followUp.plannedFollowUpDate\", \"setValue\": \"就诊日期 + 剂数 × 1 天（按用法折算）\"}" .

tcm:Behavior_Herb_DeductStock
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片库存扣减"@zh ;
    skos:notation "Herb_DeductStock" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 B-01；确认调剂时经 R-02 校验通过后同步执行，\n按单剂剂量 × 剂数扣减各味饮片库存并追加调剂出库流水（同一聚合、同一事务）"@zh ;
    tcm:precondition "R-02 判定库存充足"@zh ;
    tcm:precondition "扣减后库存不为负（REF-08）"@zh ;
    tcm:postcondition "{\"field\": \"herb.stockQuantity\", \"setValue\": \"stockQuantity - 单剂剂量 × 剂数\"}" ;
    tcm:postcondition "{\"field\": \"herb.HerbStockFlow\", \"setValue\": \"逐味追加业务类型为「调剂出库」的流水（数量为负）\"}" ;
    tcm:appliedRule "RULE-HERB-STOCK-SUFFICIENT" .

tcm:Behavior_Herb_ReturnStock
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "饮片库存回冲"@zh ;
    skos:notation "Herb_ReturnStock" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-HERB-001" ;
    tcm:ownerEntityName "中药饮片"@zh ;
    rdfs:comment "对应 B-02；处方作废经 R-04 判定为「已调剂」分支时同步执行，\n按原出库量回冲库存并追加作废回冲流水"@zh ;
    tcm:precondition "R-04 判定结果为 VOID_WITH_ROLLBACK"@zh ;
    tcm:precondition "对应调剂出库流水存在"@zh ;
    tcm:postcondition "{\"field\": \"herb.stockQuantity\", \"setValue\": \"stockQuantity + 原出库数量\"}" ;
    tcm:postcondition "{\"field\": \"herb.HerbStockFlow\", \"setValue\": \"逐味追加业务类型为「作废回冲」的流水（数量为正）\"}" ;
    tcm:appliedRule "RULE-PRESCRIPTION-VOID-DISPATCH" .

tcm:Behavior_Dispense_CreatePending
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "创建待调剂记录"@zh ;
    skos:notation "Dispense_CreatePending" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-DISPENSE-001" ;
    tcm:ownerEntityName "调剂发药记录"@zh ;
    rdfs:comment "对应 B-05（建模补全）；处方审核通过后由审批流「通过」分支调用，\n生成该处方的调剂发药记录（状态「待调剂」），成为药剂师调剂入口"@zh ;
    tcm:precondition "prescription.prescriptionStatus == '审核通过'"@zh ;
    tcm:precondition "该处方不存在调剂发药记录（一对一约束）"@zh ;
    tcm:postcondition "{\"field\": \"dispenseRecord.dispenseNo\", \"setValue\": \"系统生成\"}" ;
    tcm:postcondition "{\"field\": \"dispenseRecord.recordStatus\", \"setValue\": \"待调剂\"}" .

tcm:Behavior_Dispense_CancelPending
    a owl:NamedIndividual ;
    a tcm:Behavior ;
    rdfs:label "取消待调剂记录"@zh ;
    skos:notation "Dispense_CancelPending" ;
    tcm:behaviorType "COMMAND" ;
    tcm:triggerType "SYSTEM" ;
    tcm:ownerEntity "AGG-DISPENSE-001" ;
    tcm:ownerEntityName "调剂发药记录"@zh ;
    rdfs:comment "对应 B-06（建模补全）；处方作废经 R-04 判定为「无记录/待调剂」分支时同步执行，\n取消该处方的待调剂记录（已发药记录不可取消）"@zh ;
    tcm:precondition "R-04 判定结果为 VOID_ONLY"@zh ;
    tcm:precondition "dispenseRecord.recordStatus == '待调剂'"@zh ;
    tcm:precondition "处方状态已为「已作废」"@zh ;
    tcm:postcondition "{\"field\": \"dispenseRecord.recordStatus\", \"setValue\": \"已取消\"}" ;
    tcm:appliedRule "RULE-PRESCRIPTION-VOID-DISPATCH" .


# ---------- M3 规则 ----------
tcm:Behavior_Prescription_Save
    tcm:appliesRule tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK .

tcm:Behavior_Prescription_Submit
    tcm:appliesRule tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK .

tcm:Rule_RULE_PRESCRIPTION_DOSE_LIMIT_CHECK
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "剂量超常用量上限处理判定"@zh ;
    skos:notation "RULE-PRESCRIPTION-DOSE-LIMIT-CHECK" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "String" ;
    rdfs:comment "读取处方明细的单剂剂量与所引饮片的常用量区间，判定三种处理结论：\nPASS（未超常用上限，正常放行）/ NEED_REASON（超常用上限但在 2 倍以内，必须填写超量理由并强制药师审核）/\nBLOCK（超过常用上限 2 倍，直接阻断提交）。依据 D-11、D-16。"@zh ;
    tcm:expression "\"IF singleDose <= maxCommonDose THEN 'PASS'\\nELSE IF singleDose > maxCommonDose * 2 THEN 'BLOCK'\\nELSE IF overDoseReason IS NULL OR LENGTH(overDoseReason) == 0 THEN 'NEED_REASON'\\nELSE 'NEED_REASON'\"" ;
    tcm:inputParam "{\"name\": \"singleDose\", \"type\": \"Decimal\", \"sourceField\": \"PrescriptionItem.singleDose\", \"required\": true, \"description\": \"处方明细单剂剂量（g）\"}" ;
    tcm:inputParam "{\"name\": \"maxCommonDose\", \"type\": \"Decimal\", \"sourceField\": \"Herb.maxCommonDose\", \"required\": true, \"description\": \"饮片常用最大量（g）\"}" ;
    tcm:inputParam "{\"name\": \"minCommonDose\", \"type\": \"Decimal\", \"sourceField\": \"Herb.minCommonDose\", \"required\": true, \"description\": \"饮片常用最小量（g）\"}" ;
    tcm:inputParam "{\"name\": \"overDoseReason\", \"type\": \"String\", \"sourceField\": \"PrescriptionItem.overDoseReason\", \"required\": false, \"description\": \"超量理由，超常用上限时必填\"}" ;
    tcm:reusedByBehavior "Prescription_Save" ;
    tcm:reusedByBehavior "Prescription_Submit" .

tcm:Behavior_Dispense_Confirm
    tcm:appliesRule tcm:Rule_RULE_HERB_STOCK_SUFFICIENT .

tcm:Rule_RULE_HERB_STOCK_SUFFICIENT
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "饮片库存充足校验"@zh ;
    skos:notation "RULE-HERB-STOCK-SUFFICIENT" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "Boolean" ;
    rdfs:comment "按处方剂数计算各味饮片需求总量，逐味比对饮片当前库存数量，任一味不足则阻断调剂（D-14）。"@zh ;
    tcm:expression "\"FOR EACH item IN prescriptionItems:\\n  IF item.singleDose * prescription.doses > herb(item.herbId).stockQuantity THEN RETURN false\\nRETURN true\"" ;
    tcm:inputParam "{\"name\": \"requiredQuantity\", \"type\": \"Decimal\", \"sourceField\": \"PrescriptionItem.singleDose * Prescription.doses\", \"required\": true, \"description\": \"该味饮片需求总量 = 单剂剂量 × 剂数（g）\"}" ;
    tcm:inputParam "{\"name\": \"stockQuantity\", \"type\": \"Decimal\", \"sourceField\": \"Herb.stockQuantity\", \"required\": true, \"description\": \"饮片当前库存数量（g）\"}" ;
    tcm:reusedByBehavior "Dispense_Confirm" .

tcm:Behavior_Prescription_Submit
    tcm:appliesRule tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK .

tcm:Rule_RULE_HERB_TOXIC_TOTAL_LIMIT_CHECK
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "毒性饮片处方总量上限校验"@zh ;
    skos:notation "RULE-HERB-TOXIC-TOTAL-LIMIT-CHECK" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "Boolean" ;
    rdfs:comment "对处方内毒性分级非「无毒」的饮片，按单剂剂量汇总同味饮片总量，与饮片维护的「毒性单张处方总量上限」比对，\n超上限即阻断提交；未维护上限的毒性饮片只做强制审核提示。依据 D-11。"@zh ;
    tcm:expression "\"IF toxicityLevel == 'NONE' THEN RETURN true\\nIF toxicDoseLimit IS NULL THEN RETURN true\\nRETURN totalDoseInPrescription <= toxicDoseLimit\"" ;
    tcm:inputParam "{\"name\": \"herbId\", \"type\": \"String\", \"sourceField\": \"PrescriptionItem.herbId\", \"required\": true}" ;
    tcm:inputParam "{\"name\": \"toxicityLevel\", \"type\": \"String\", \"sourceField\": \"Herb.toxicityLevel\", \"required\": true, \"description\": \"毒性分级字典值，NONE 表示无毒\"}" ;
    tcm:inputParam "{\"name\": \"toxicDoseLimit\", \"type\": \"Decimal\", \"sourceField\": \"Herb.toxicDoseLimit\", \"required\": false, \"description\": \"毒性单张处方总量上限（g），为空表示不单独设限\"}" ;
    tcm:inputParam "{\"name\": \"totalDoseInPrescription\", \"type\": \"Decimal\", \"sourceField\": \"SUM(PrescriptionItem.singleDose)\", \"required\": true, \"description\": \"同一处方内该味饮片的单剂总量（g）\"}" ;
    tcm:reusedByBehavior "Prescription_Submit" .

tcm:Behavior_Prescription_Cancel
    tcm:appliesRule tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH .

tcm:Rule_RULE_PRESCRIPTION_VOID_DISPATCH
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "处方作废处理判定与阻断"@zh ;
    skos:notation "RULE-PRESCRIPTION-VOID-DISPATCH" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "String" ;
    rdfs:comment "按调剂发药记录状态三分派：无记录或「待调剂」→ VOID_ONLY（允许作废，无库存动作，同步取消待调剂记录）；\n「已调剂」→ VOID_WITH_ROLLBACK（允许作废并按 B-02 回冲库存）；「已发药」→ BLOCK（阻断作废，\n退药走线下处理）。规则只判断与分派，状态变化由行为完成。依据 D-08、D-19。"@zh ;
    tcm:expression "\"IF recordStatus IS NULL THEN RETURN 'VOID_ONLY'\\nIF recordStatus == 'PENDING' THEN RETURN 'VOID_ONLY'\\nIF recordStatus == 'DISPENSED' THEN RETURN 'VOID_WITH_ROLLBACK'\\nIF recordStatus == 'ISSUED' THEN RETURN 'BLOCK'\\nRETURN 'VOID_ONLY'\"" ;
    tcm:inputParam "{\"name\": \"recordStatus\", \"type\": \"String\", \"sourceField\": \"DispenseRecord.recordStatus\", \"required\": false, \"description\": \"调剂发药记录状态；无记录时为空\"}" ;
    tcm:inputParam "{\"name\": \"prescriptionStatus\", \"type\": \"String\", \"sourceField\": \"Prescription.prescriptionStatus\", \"required\": true, \"description\": \"当前处方状态\"}" ;
    tcm:reusedByBehavior "Prescription_Cancel" .

tcm:Behavior_FollowUp_Complete
    tcm:appliesRule tcm:Rule_RULE_FOLLOWUP_DATE_ORDER .

tcm:Rule_RULE_FOLLOWUP_DATE_ORDER
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "复诊日期顺序校验"@zh ;
    skos:notation "RULE-FOLLOWUP-DATE-ORDER" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "Boolean" ;
    rdfs:comment "实际随访日期不得早于随访来源就诊的挂号时间；违反时提示并要求修正（D-17）。"@zh ;
    tcm:expression "\"actualFollowUpDate >= DATE(sourceVisitRegisterTime)\"" ;
    tcm:inputParam "{\"name\": \"actualFollowUpDate\", \"type\": \"Date\", \"sourceField\": \"FollowUp.actualFollowUpDate\", \"required\": true}" ;
    tcm:inputParam "{\"name\": \"sourceVisitRegisterTime\", \"type\": \"DateTime\", \"sourceField\": \"Visit.registerTime\", \"required\": true, \"description\": \"上次就诊（随访来源）的挂号时间\"}" ;
    tcm:reusedByBehavior "FollowUp_Complete" .

tcm:Behavior_Herb_Stocktake
    tcm:appliesRule tcm:Rule_RULE_HERB_STOCK_RECONCILE .

tcm:Rule_RULE_HERB_STOCK_RECONCILE
    a owl:NamedIndividual ;
    a tcm:Rule ;
    rdfs:label "饮片库存对账校验"@zh ;
    skos:notation "RULE-HERB-STOCK-RECONCILE" ;
    tcm:ruleType "VALIDATION" ;
    tcm:outputType "Decimal" ;
    rdfs:comment "盘点时以饮片库存数量与全部出入库流水数量净和比对，输出对账结论与差异值（不阻断业务，供盘点人员据以发起盘点调整）。\n与 M1 聚合不变量 INV-03 同源：INV-03 为写入时强制的聚合不变量，本规则为盘点行为的对账判定与差异呈现。依据 INV-03。"@zh ;
    tcm:expression "\"stockQuantity - flowNetQuantity\"" ;
    tcm:inputParam "{\"name\": \"stockQuantity\", \"type\": \"Decimal\", \"sourceField\": \"Herb.stockQuantity\", \"required\": true}" ;
    tcm:inputParam "{\"name\": \"flowNetQuantity\", \"type\": \"Decimal\", \"sourceField\": \"SUM(HerbStockFlow.quantity)\", \"required\": true, \"description\": \"该饮片全部出入库流水数量净和（g）\"}" ;
    tcm:reusedByBehavior "Herb_Stocktake" .


# ---------- M6 流程 ----------
tcm:Flow_FLOW_VISIT_001
    a owl:NamedIndividual ;
    a tcm:Flow ;
    rdfs:label "门诊问诊开方主流程"@zh ;
    skos:notation "FLOW-VISIT-001" ;
    tcm:flowType "COLLABORATION" ;
    rdfs:comment "完成一名患者从建档挂号、四诊采集、辨证开方、处方审核到调剂发药的全过程"@zh ;
    tcm:businessObject "AGG-PATIENT-001" ;
    tcm:businessObject "AGG-VISIT-001" ;
    tcm:businessObject "AGG-DIAGNOSIS-001" ;
    tcm:businessObject "AGG-FORMULA-001" ;
    tcm:businessObject "AGG-PRESCRIPTION-001" ;
    tcm:businessObject "AGG-HERB-001" ;
    tcm:businessObject "AGG-DISPENSE-001" ;
    tcm:businessObject "AGG-FOLLOWUP-001" ;
    tcm:involvedRole "ROLE-01" ;
    tcm:involvedRole "ROLE-02" ;
    tcm:involvedRole "ROLE-03" ;
    tcm:involvedRole "ROLE-05" ;
    tcm:startActivity "A01" ;
    tcm:endActivity "E01" ;
    tcm:endActivity "E02" ;
    tcm:endActivity "E03" ;
    tcm:endActivity "E04" .

tcm:Activity_FLOW_VISIT_001_A01
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "开始（患者到达门诊）"@zh ;
    skos:notation "A01" ;
    tcm:activityType "START" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A01 .

tcm:Activity_FLOW_VISIT_001_A02
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "患者建档（老患者跳过）"@zh ;
    skos:notation "A02" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A02 .

tcm:Activity_FLOW_VISIT_001_A03
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "门诊挂号"@zh ;
    skos:notation "A03" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-01" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A03 .

tcm:Activity_FLOW_VISIT_001_A04
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "接诊开单"@zh ;
    skos:notation "A04" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A04 .

tcm:Activity_FLOW_VISIT_001_A05
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "录入四诊信息"@zh ;
    skos:notation "A05" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A05 .

tcm:Activity_FLOW_VISIT_001_A06
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "辨证判定并确认结论"@zh ;
    skos:notation "A06" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-02" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_A06 .

tcm:Activity_FLOW_VISIT_001_A07
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
