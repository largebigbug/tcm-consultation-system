    tcm:activityType "GATEWAY" .

tcm:Flow_FLOW_VISIT_001
    tcm:hasActivity tcm:Activity_FLOW_VISIT_001_G04 .

tcm:Activity_FLOW_VISIT_001_A14
    a owl:NamedIndividual ;
    a tcm:FlowActivity ;
    rdfs:label "发药确认（与患者核对交接）"@zh ;
    skos:notation "A14" ;
    tcm:activityType "USER_TASK" ;
    tcm:performer "ROLE-03" .

tcm:Flow_FLOW_VISIT_001
